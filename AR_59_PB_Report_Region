------------------------------------------------------------
-- 8) CREATE AUTHORIZED PB FACILITY LIST
--
-- One row per authorized FacilityID1.
--
-- Specialty is retained from FacilityName2.
-- AU follows the logic from the original PB query.
------------------------------------------------------------

IF OBJECT_ID('tempdb..#AuthorizedPBFacilities') IS NOT NULL
    DROP TABLE #AuthorizedPBFacilities;

CREATE TABLE #AuthorizedPBFacilities
(
    Specialty VARCHAR(128) NULL,
    AU VARCHAR(9) NULL,

    FacilityID INT NOT NULL,
    FacilityCode VARCHAR(100) NULL,
    FacilityName VARCHAR(255) NULL
);

;WITH RankedAuthorizedFacilities AS
(
    SELECT
        NULLIF
        (
            LTRIM(RTRIM(FS.FacilityName2)),
            ''
        ) AS Specialty,

        LEFT
        (
            LTRIM(RTRIM(FS.FacilityName1)),
            9
        ) AS AU,

        FS.FacilityID1 AS FacilityID,
        FS.FacilityCode1 AS FacilityCode,
        FS.FacilityName1 AS FacilityName,

        ROW_NUMBER() OVER
        (
            PARTITION BY FS.FacilityID1

            ORDER BY
                CASE
                    WHEN NULLIF
                    (
                        LTRIM(RTRIM(FS.FacilityName2)),
                        ''
                    ) IS NULL
                    THEN 1
                    ELSE 0
                END,

                FS.FacilityName2,
                FS.FacilityName1,
                FS.FacilityCode1

        ) AS FacilityRow

    FROM #FacilityStructure AS FS

    WHERE FS.FacilityID1 IS NOT NULL
)
INSERT INTO #AuthorizedPBFacilities
(
    Specialty,
    AU,
    FacilityID,
    FacilityCode,
    FacilityName
)
SELECT
    Specialty,
    AU,
    FacilityID,
    FacilityCode,
    FacilityName

FROM RankedAuthorizedFacilities

WHERE FacilityRow = 1;


