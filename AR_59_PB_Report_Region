------------------------------------------------------------
-- 9) CREATE PB REPORT REGION MAPPING
--
-- Maps each authorized PB FacilityID1 to its verified
-- Report Region.
------------------------------------------------------------

IF OBJECT_ID('tempdb..#PBReportRegionMapping') IS NOT NULL
    DROP TABLE #PBReportRegionMapping;

CREATE TABLE #PBReportRegionMapping
(
    ReportRegionID INT NOT NULL,
    ReportRegion VARCHAR(128) NOT NULL,

    Specialty VARCHAR(128) NULL,
    AU VARCHAR(9) NULL,

    FacilityID INT NOT NULL,
    FacilityCode VARCHAR(100) NULL,
    FacilityName VARCHAR(255) NULL
);

INSERT INTO #PBReportRegionMapping
(
    ReportRegionID,
    ReportRegion,
    Specialty,
    AU,
    FacilityID,
    FacilityCode,
    FacilityName
)
SELECT DISTINCT
    GC.GroupCategoryID,
    LTRIM(RTRIM(GC.GroupCategoryName)),

    APB.Specialty,
    APB.AU,

    APB.FacilityID,
    APB.FacilityCode,
    APB.FacilityName

FROM #AuthorizedPBFacilities AS APB

INNER JOIN Analysis.FacilityGroup AS FG
    ON FG.FacilityID = APB.FacilityID

INNER JOIN @ReportRegions AS RR
    ON RR.ReportRegionID = FG.GroupCategoryID

INNER JOIN Analysis.dimGroupCategory AS GC
    ON GC.GroupCategoryID = FG.GroupCategoryID;


------------------------------------------------------------
-- 10) VERIFY REPORT REGION MAPPING EXISTS
------------------------------------------------------------

IF NOT EXISTS
(
    SELECT 1
    FROM #PBReportRegionMapping
)
BEGIN

    THROW 50005,
        'No authorized PB facilities were found for the verified Report Region groups.',
        1;

END;


------------------------------------------------------------
-- 11) CHECK WHETHER ANY FACILITY HAS MORE THAN ONE
--     REPORT REGION
------------------------------------------------------------

SELECT
    FacilityID,
    MAX(FacilityCode) AS FacilityCode,
    MAX(FacilityName) AS FacilityName,
    COUNT(DISTINCT ReportRegionID) AS ReportRegionCount

FROM #PBReportRegionMapping

GROUP BY
    FacilityID

HAVING COUNT(DISTINCT ReportRegionID) > 1

ORDER BY
    FacilityID;


