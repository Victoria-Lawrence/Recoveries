-- 22) CREATE RUN LOG
--
-- V2 name prevents SQL Server from binding to an older
-- #AR059PBRunLog temp-table definition during compilation.
------------------------------------------------------------

IF OBJECT_ID('tempdb..#AR059PBRunLog') IS NOT NULL
    DROP TABLE #AR059PBRunLog;

CREATE TABLE #AR059PBRunLog
(
    RangeOrder INT NOT NULL,
    RangeLabel VARCHAR(100) NULL,

    AnalysisPeriodID INT NULL,
    ActivityThroughPeriodID INT NULL,

    ReportRegionCount INT NULL,
    SpecialtyCount INT NULL,
    FacilityCount INT NULL,

    ReturnedRecordCount BIGINT NULL,
    IncludeDaysMetCount BIGINT NULL,
    MappedDetailCount BIGINT NULL,
    UnmappedDetailCount BIGINT NULL,

    RunStatus VARCHAR(20) NULL,

    ErrorNumber INT NULL,
    ErrorLine INT NULL,
    ErrorMessage VARCHAR(4000) NULL
);


------------------------------------------------------------
-- 23) DECLARE LOOP VARIABLES
------------------------------------------------------------

DECLARE @RangeOrder INT;
DECLARE @MaximumRangeOrder INT;
DECLARE @RangeLabel VARCHAR(100);
DECLARE @PeriodID INT;
DECLARE @EndPeriodID INT;

DECLARE @ReturnedRecordCount BIGINT;
DECLARE @IncludeDaysMetCount BIGINT;
DECLARE @MappedDetailCount BIGINT;
DECLARE @UnmappedDetailCount BIGINT;

SELECT
    @RangeOrder = MIN(RangeOrder),
    @MaximumRangeOrder = MAX(RangeOrder)
FROM @Ranges;

------------------------------------------------------------
-- 24) RUN PB AR059 FOR EACH RANGE
------------------------------------------------------------

WHILE @RangeOrder <= @MaximumRangeOrder
BEGIN

    --------------------------------------------------------
    -- Get current range
    --------------------------------------------------------

    SELECT
        @RangeLabel = RangeLabel,

        @PeriodID = AnalysisPeriodID,

        @EndPeriodID = ActivityThroughPeriodID

    FROM @Ranges

    WHERE RangeOrder = @RangeOrder;


    --------------------------------------------------------
    -- Reset staging table and counts
    --------------------------------------------------------

    TRUNCATE TABLE #AR059Stage;

    SET @ReturnedRecordCount = 0;

    SET @IncludeDaysMetCount = 0;

    SET @MappedDetailCount = 0;

    SET @UnmappedDetailCount = 0;


    BEGIN TRY

        ----------------------------------------------------
        -- Run PB AR059
        ----------------------------------------------------

        INSERT INTO #AR059Stage
        (
            FacilityID,
            FacilityName,
            InOutType,
            AccountNumber,
            SIPGCode,
            SIPGName,
            FCCode,
            FCName,
            IPCode,
            IPName,
            PostingDate,
            BillingType,
            AdmissionDate,
            DischargeDate,
            TransactionCode,
            TransactionDescription,
            TransactionAmount,
            [Status],
            RecoveryTakeback,
            DaysFromAdmission,
            IncludeExclude,
            PriorTransaction
        )
        EXEC RCA_Phys_Code.Analysis.pr_AR059_BadDebtAndInactiveAccountRecoveryPayments
            @FacilityIDs = @FacilityIDs,
            @PeriodID = @PeriodID,
            @EndPeriodID = @EndPeriodID,
            @InOutTypes = @InOutTypes,
            @Username = @Username,
            @RAC = @RAC,
            @ExcludeAccounts = @ExcludeAccounts,
            @Status = @Status,
            @PayorType = @PayorType,
            @PayorCodes = @PayorCodes,
            @SystemType = @SystemType,
            @UDFilter1 = @UDFilter1,
            @DaysThreshold = @DaysThreshold,
            @AuthMode = @AuthMode;


        ----------------------------------------------------
        -- Count returned and included records
        ----------------------------------------------------

        SELECT
            @ReturnedRecordCount = COUNT_BIG(1)

        FROM #AR059Stage;


        SELECT
            @IncludeDaysMetCount = COUNT_BIG(1)

        FROM #AR059Stage

        WHERE IncludeExclude = 'Include Days Met';


        ----------------------------------------------------
        -- Capture included AR059 facilities not found in
        -- the Report Region mapping.
        ----------------------------------------------------

        INSERT INTO #AR059UnmappedFacilities
        (
            RangeOrder,
            RangeLabel,

            AnalysisPeriodID,
            ActivityThroughPeriodID,

            FacilityID,
            FacilityName,

            ReturnedRecordCount
        )
        SELECT
            @RangeOrder,
            @RangeLabel,

            @PeriodID,
            @EndPeriodID,

            AR.FacilityID,
            AR.FacilityName,

            COUNT_BIG(1)

        FROM #AR059Stage AS AR

        LEFT JOIN #PBReportRegionMapping AS RM
            ON RM.FacilityID = AR.FacilityID

        WHERE AR.IncludeExclude = 'Include Days Met'
          AND RM.FacilityID IS NULL

        GROUP BY
            AR.FacilityID,
            AR.FacilityName;


        SELECT
            @UnmappedDetailCount = COUNT_BIG(1)

        FROM #AR059Stage AS AR

        LEFT JOIN #PBReportRegionMapping AS RM
            ON RM.FacilityID = AR.FacilityID

        WHERE AR.IncludeExclude = 'Include Days Met'
          AND RM.FacilityID IS NULL;


        ----------------------------------------------------
        -- Save mapped included transaction detail
        ----------------------------------------------------

        INSERT INTO #AR059PBDetail
        (
            RangeOrder,
            RangeLabel,

            AnalysisPeriodID,
            ActivityThroughPeriodID,

            ReportRegionID,
            ReportRegion,

            Specialty,
            AU,

            MappedFacilityID,
            MappedFacilityCode,
            MappedFacilityName,

            FacilityID,
            FacilityName,

            InOutType,
            AccountNumber,

            SIPGCode,
            SIPGName,

            FCCode,
            FCName,

            IPCode,
            IPName,

            PostingDate,

            BillingType,

            AdmissionDate,
            DischargeDate,

            TransactionCode,
            TransactionDescription,

            TransactionAmount,

            [Status],

            RecoveryTakeback,

            DaysFromAdmission,

            IncludeExclude,

            PriorTransaction
        )
        SELECT
            @RangeOrder,
            @RangeLabel,

            @PeriodID,
            @EndPeriodID,

            RM.ReportRegionID,
            RM.ReportRegion,

            RM.Specialty,
            RM.AU,

            RM.FacilityID,
            RM.FacilityCode,
            RM.FacilityName,

            AR.FacilityID,
            AR.FacilityName,

            AR.InOutType,
            AR.AccountNumber,

            AR.SIPGCode,
            AR.SIPGName,

            AR.FCCode,
            AR.FCName,

            AR.IPCode,
            AR.IPName,

            AR.PostingDate,

            AR.BillingType,

            AR.AdmissionDate,
            AR.DischargeDate,

            AR.TransactionCode,
            AR.TransactionDescription,

            AR.TransactionAmount,

            AR.[Status],

            AR.RecoveryTakeback,

            AR.DaysFromAdmission,

            AR.IncludeExclude,

            AR.PriorTransaction

        FROM #AR059Stage AS AR

        INNER JOIN #PBReportRegionMapping AS RM
            ON RM.FacilityID = AR.FacilityID

        WHERE AR.IncludeExclude = 'Include Days Met';


        SET @MappedDetailCount = @@ROWCOUNT;


        ----------------------------------------------------
        -- Log successful range
        ----------------------------------------------------

        INSERT INTO #AR059PBRunLog
        (
            RangeOrder,
            RangeLabel,

            AnalysisPeriodID,
            ActivityThroughPeriodID,

            ReportRegionCount,
            SpecialtyCount,
            FacilityCount,

            ReturnedRecordCount,

            IncludeDaysMetCount,

            MappedDetailCount,

            UnmappedDetailCount,

            RunStatus,

            ErrorNumber,
            ErrorLine,
            ErrorMessage
        )
        VALUES
        (
            @RangeOrder,
            @RangeLabel,

            @PeriodID,
            @EndPeriodID,

            @ReportRegionCount,
            @SpecialtyCount,
            @FacilityCount,

            @ReturnedRecordCount,

            @IncludeDaysMetCount,

            @MappedDetailCount,

            @UnmappedDetailCount,

            'Completed',

            NULL,
            NULL,
            NULL
        );

    END TRY

    BEGIN CATCH

        ----------------------------------------------------
        -- Log error and continue to the next range
        ----------------------------------------------------

        INSERT INTO #AR059PBRunLog
        (
            RangeOrder,
            RangeLabel,

            AnalysisPeriodID,
            ActivityThroughPeriodID,

            ReportRegionCount,
            SpecialtyCount,
            FacilityCount,

            ReturnedRecordCount,

            IncludeDaysMetCount,

            MappedDetailCount,

            UnmappedDetailCount,

            RunStatus,

            ErrorNumber,
            ErrorLine,
            ErrorMessage
        )
        VALUES
        (
            @RangeOrder,
            @RangeLabel,

            @PeriodID,
            @EndPeriodID,

            @ReportRegionCount,
            @SpecialtyCount,
            @FacilityCount,

            @ReturnedRecordCount,

            @IncludeDaysMetCount,

            @MappedDetailCount,

            @UnmappedDetailCount,

            'Error',

            ERROR_NUMBER(),
            ERROR_LINE(),
            ERROR_MESSAGE()
        );

    END CATCH;


    SET @RangeOrder = @RangeOrder + 1;

END;


------------------------------------------------------------
-- 25) SIX-RANGE OVERALL PB SUMMARY
------------------------------------------------------------

SELECT
    RangeOrder,
    RangeLabel,

    AnalysisPeriodID,
    ActivityThroughPeriodID,

    COUNT_BIG(1) AS TransactionRowCount,

    COUNT(DISTINCT AccountNumber) AS DistinctAccountCount,

    SUM
    (
        CASE
            WHEN RecoveryTakeback = 'Net Recovery'
            THEN TransactionAmount
            ELSE 0
        END
    ) AS NetRecoveryAmount,

    SUM
    (
        CASE
            WHEN RecoveryTakeback = 'Net Takeback'
            THEN TransactionAmount
            ELSE 0
        END
    ) AS NetTakebackAmount,

    SUM(TransactionAmount) AS NetAmount

FROM #AR059PBDetail

GROUP BY
    RangeOrder,
    RangeLabel,

    AnalysisPeriodID,
    ActivityThroughPeriodID

ORDER BY
    RangeOrder;


------------------------------------------------------------
-- 26) RANGE AND REPORT REGION SUMMARY
--
-- This is the primary requested Report Region grouping.
------------------------------------------------------------

SELECT
    RangeOrder,
    RangeLabel,

    AnalysisPeriodID,
    ActivityThroughPeriodID,

    ReportRegionID,
    ReportRegion,

    COUNT_BIG(1) AS TransactionRowCount,

    COUNT(DISTINCT AccountNumber) AS DistinctAccountCount,

    SUM
    (
        CASE
            WHEN RecoveryTakeback = 'Net Recovery'
            THEN TransactionAmount
            ELSE 0
        END
    ) AS NetRecoveryAmount,

    SUM
    (
        CASE
            WHEN RecoveryTakeback = 'Net Takeback'
            THEN TransactionAmount
            ELSE 0
        END
    ) AS NetTakebackAmount,

    SUM(TransactionAmount) AS NetAmount

FROM #AR059PBDetail

GROUP BY
    RangeOrder,
    RangeLabel,

    AnalysisPeriodID,
    ActivityThroughPeriodID,

    ReportRegionID,
    ReportRegion

ORDER BY
    RangeOrder,
    ReportRegion;


