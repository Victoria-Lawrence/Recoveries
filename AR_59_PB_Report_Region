------------------------------------------------------------
-- 12) CREATE FINAL SIX-RANGE DETAIL TABLE
------------------------------------------------------------

IF OBJECT_ID('tempdb..#AR059GroupDetail') IS NOT NULL
    DROP TABLE #AR059GroupDetail;

CREATE TABLE #AR059GroupDetail
(
    RangeOrder INT,
    RangeLabel VARCHAR(100),
    AnalysisPeriodID INT,
    ActivityThroughPeriodID INT,

    GroupCategoryID INT,
    GroupCategoryName VARCHAR(128),

    Specialty VARCHAR(128),
    AU VARCHAR(9),

    MappedFacilityID INT,
    MappedFacilityCode VARCHAR(100),
    MappedFacilityName VARCHAR(255),

    FacilityID INT,
    FacilityName VARCHAR(256),
    InOutType VARCHAR(32),
    AccountNumber VARCHAR(256),

    SIPGCode VARCHAR(50),
    SIPGName VARCHAR(256),

    FCCode VARCHAR(50),
    FCName VARCHAR(256),

    IPCode VARCHAR(50),
    IPName VARCHAR(256),

    PostingDate DATETIME,
    BillingType VARCHAR(50),
    AdmissionDate DATETIME,
    DischargeDate DATETIME,

    TransactionCode VARCHAR(50),
    TransactionDescription VARCHAR(256),
    TransactionAmount MONEY,

    [Status] VARCHAR(20),
    RecoveryTakeback VARCHAR(20),
    DaysFromAdmission INT,
    IncludeExclude VARCHAR(50),
    PriorTransaction VARCHAR(50)
);


------------------------------------------------------------
-- 13) CREATE RUN LOG
------------------------------------------------------------

IF OBJECT_ID('tempdb..#AR059RunLog') IS NOT NULL
    DROP TABLE #AR059RunLog;

CREATE TABLE #AR059RunLog
(
    RangeOrder INT,
    RangeLabel VARCHAR(100),
    AnalysisPeriodID INT,
    ActivityThroughPeriodID INT,

    GroupCategoryID INT,
    GroupCategoryName VARCHAR(128),

    FacilityCount INT,
    ReturnedRecordCount BIGINT,
    IncludeDaysMetCount BIGINT,
    FinalDetailCount BIGINT,

    RunStatus VARCHAR(20),
    ErrorNumber INT NULL,
    ErrorLine INT NULL,
    ErrorMessage VARCHAR(4000) NULL
);


------------------------------------------------------------
-- 14) DECLARE LOOP VARIABLES
------------------------------------------------------------

DECLARE @RangeOrder INT;
DECLARE @MaximumRangeOrder INT;

DECLARE @RangeLabel VARCHAR(100);
DECLARE @PeriodID INT;
DECLARE @EndPeriodID INT;

DECLARE @ReturnedRecordCount BIGINT;
DECLARE @IncludeDaysMetCount BIGINT;
DECLARE @FinalDetailCount BIGINT;


SELECT
    @RangeOrder = MIN(RangeOrder),
    @MaximumRangeOrder = MAX(RangeOrder)
FROM @Ranges;


------------------------------------------------------------
-- 15) RUN AR059 FOR EACH RANGE
------------------------------------------------------------

WHILE @RangeOrder <= @MaximumRangeOrder
BEGIN

    --------------------------------------------------------
    -- Get current range
    --------------------------------------------------------

    SELECT
        @RangeLabel = RangeLabel,
        @PeriodID = AnalysisPeriodID,
        @EndPeriodID = ActivityThroughPeriodID
    FROM @Ranges
    WHERE RangeOrder = @RangeOrder;


    --------------------------------------------------------
    -- Reset staging table and counts
    --------------------------------------------------------

    TRUNCATE TABLE #AR059Stage;

    SET @ReturnedRecordCount = 0;
    SET @IncludeDaysMetCount = 0;
    SET @FinalDetailCount = 0;


    BEGIN TRY

        ----------------------------------------------------
        -- Run the existing AR059 stored procedure
        ----------------------------------------------------

        INSERT INTO #AR059Stage
        (
            FacilityID,
            FacilityName,
            InOutType,
            AccountNumber,

            SIPGCode,
            SIPGName,

            FCCode,
            FCName,

            IPCode,
            IPName,

            PostingDate,
            BillingType,
            AdmissionDate,
            DischargeDate,

            TransactionCode,
            TransactionDescription,
            TransactionAmount,

            [Status],
            RecoveryTakeback,
            DaysFromAdmission,
            IncludeExclude,
            PriorTransaction
        )
        EXEC RCA_Phys_Code.Analysis.pr_AR059_BadDebtAndInactiveAccountRecoveryPayments
            @FacilityIDs     = @FacilityIDs,
            @PeriodID        = @PeriodID,
            @EndPeriodID     = @EndPeriodID,
            @InOutTypes      = @InOutTypes,
            @Username        = @Username,
            @RAC             = @RAC,
            @ExcludeAccounts = @ExcludeAccounts,
            @Status          = @Status,
            @PayorType       = @PayorType,
            @PayorCodes      = @PayorCodes,
            @SystemType      = @SystemType,
            @UDFilter1       = @UDFilter1,
            @DaysThreshold   = @DaysThreshold,
            @AuthMode        = @AuthMode;


        ----------------------------------------------------
        -- Count returned and included records
        ----------------------------------------------------

        SELECT
            @ReturnedRecordCount = COUNT_BIG(1)
        FROM #AR059Stage;


        SELECT
            @IncludeDaysMetCount = COUNT_BIG(1)
        FROM #AR059Stage
        WHERE IncludeExclude = 'Include Days Met';


        ----------------------------------------------------
        -- Save included transaction detail
        ----------------------------------------------------

        INSERT INTO #AR059GroupDetail
        (
            RangeOrder,
            RangeLabel,
            AnalysisPeriodID,
            ActivityThroughPeriodID,

            GroupCategoryID,
            GroupCategoryName,

            Specialty,
            AU,

            MappedFacilityID,
            MappedFacilityCode,
            MappedFacilityName,

            FacilityID,
            FacilityName,
            InOutType,
            AccountNumber,

            SIPGCode,
            SIPGName,

            FCCode,
            FCName,

            IPCode,
            IPName,

            PostingDate,
            BillingType,
            AdmissionDate,
            DischargeDate,

            TransactionCode,
            TransactionDescription,
            TransactionAmount,

            [Status],
            RecoveryTakeback,
            DaysFromAdmission,
            IncludeExclude,
            PriorTransaction
        )
        SELECT
            @RangeOrder,
            @RangeLabel,
            @PeriodID,
            @EndPeriodID,

            GM.GroupCategoryID,
            GM.GroupCategoryName,

            GM.Specialty,
            GM.AU,

            GM.FacilityID,
            GM.FacilityCode,
            GM.FacilityName,

            AR.FacilityID,
            AR.FacilityName,
            AR.InOutType,
            AR.AccountNumber,

            AR.SIPGCode,
            AR.SIPGName,

            AR.FCCode,
            AR.FCName,

            AR.IPCode,
            AR.IPName,

            AR.PostingDate,
            AR.BillingType,
            AR.AdmissionDate,
            AR.DischargeDate,

            AR.TransactionCode,
            AR.TransactionDescription,
            AR.TransactionAmount,

            AR.[Status],
            AR.RecoveryTakeback,
            AR.DaysFromAdmission,
            AR.IncludeExclude,
            AR.PriorTransaction

        FROM #AR059Stage AS AR

        INNER JOIN #GroupFacilityMapping AS GM
            ON GM.FacilityID = AR.FacilityID

        WHERE AR.IncludeExclude = 'Include Days Met';

        SET @FinalDetailCount = @@ROWCOUNT;


        ----------------------------------------------------
        -- Log successful range
        ----------------------------------------------------

        INSERT INTO #AR059RunLog
        (
            RangeOrder,
            RangeLabel,
            AnalysisPeriodID,
            ActivityThroughPeriodID,

            GroupCategoryID,
            GroupCategoryName,

            FacilityCount,
            ReturnedRecordCount,
            IncludeDaysMetCount,
            FinalDetailCount,

            RunStatus,
            ErrorNumber,
            ErrorLine,
            ErrorMessage
        )
        VALUES
        (
            @RangeOrder,
            @RangeLabel,
            @PeriodID,
            @EndPeriodID,

            @GroupCategoryID,
            @GroupCategoryName,

            @FacilityCount,
            @ReturnedRecordCount,
            @IncludeDaysMetCount,
            @FinalDetailCount,

            'Completed',
            NULL,
            NULL,
            NULL
        );

    END TRY

    BEGIN CATCH

        ----------------------------------------------------
        -- Log error and continue to the next range
        ----------------------------------------------------

        INSERT INTO #AR059RunLog
        (
            RangeOrder,
            RangeLabel,
            AnalysisPeriodID,
            ActivityThroughPeriodID,

            GroupCategoryID,
            GroupCategoryName,

            FacilityCount,
            ReturnedRecordCount,
            IncludeDaysMetCount,
            FinalDetailCount,

            RunStatus,
            ErrorNumber,
            ErrorLine,
            ErrorMessage
        )
        VALUES
        (
            @RangeOrder,
            @RangeLabel,
            @PeriodID,
            @EndPeriodID,

            @GroupCategoryID,
            @GroupCategoryName,

            @FacilityCount,
            0,
            0,
            0,

            'Error',
            ERROR_NUMBER(),
            ERROR_LINE(),
            ERROR_MESSAGE()
        );

    END CATCH;


    SET @RangeOrder = @RangeOrder + 1;

END;


------------------------------------------------------------
-- 16) SIX-RANGE OVERALL SUMMARY
------------------------------------------------------------

SELECT
    RangeOrder,
    RangeLabel,
    AnalysisPeriodID,
    ActivityThroughPeriodID,

    GroupCategoryID,
    GroupCategoryName,

    COUNT_BIG(1) AS TransactionRowCount,
    COUNT(DISTINCT AccountNumber) AS DistinctAccountCount,

    SUM
    (
        CASE
            WHEN RecoveryTakeback = 'Net Recovery'
            THEN TransactionAmount
            ELSE 0
        END
    ) AS NetRecoveryAmount,

    SUM
    (
        CASE
            WHEN RecoveryTakeback = 'Net Takeback'
            THEN TransactionAmount
            ELSE 0
        END
    ) AS NetTakebackAmount,

    SUM(TransactionAmount) AS NetAmount

FROM #AR059GroupDetail

GROUP BY
    RangeOrder,
    RangeLabel,
    AnalysisPeriodID,
    ActivityThroughPeriodID,
    GroupCategoryID,
    GroupCategoryName

ORDER BY
    RangeOrder;


------------------------------------------------------------
-- 17) RANGE AND SPECIALTY SUMMARY
------------------------------------------------------------

SELECT
    RangeOrder,
    RangeLabel,
    AnalysisPeriodID,
    ActivityThroughPeriodID,

    GroupCategoryID,
    GroupCategoryName,

    Specialty,

    COUNT_BIG(1) AS TransactionRowCount,
    COUNT(DISTINCT AccountNumber) AS DistinctAccountCount,

