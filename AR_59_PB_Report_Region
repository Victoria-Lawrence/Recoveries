------------------------------------------------------------
-- 16) CREATE UNMAPPED FACILITY TABLE
------------------------------------------------------------

IF OBJECT_ID('tempdb..#AR059UnmappedFacilities') IS NOT NULL
    DROP TABLE #AR059UnmappedFacilities;

CREATE TABLE #AR059UnmappedFacilities
(
    RangeOrder INT,
    RangeLabel VARCHAR(100),
    AnalysisPeriodID INT,
    ActivityThroughPeriodID INT,
    FacilityID INT,
    FacilityName VARCHAR(256),
    IncludedRecordCount BIGINT
);

------------------------------------------------------------
-- 17) CREATE RUN LOG
------------------------------------------------------------

IF OBJECT_ID('tempdb..#AR059PBSummaryRunLog') IS NOT NULL
    DROP TABLE #AR059PBSummaryRunLog;

CREATE TABLE #AR059PBSummaryRunLog
(
    RangeOrder INT,
    RangeLabel VARCHAR(100),
    AnalysisPeriodID INT,
    ActivityThroughPeriodID INT,
    ReportRegionCount INT,
    FacilityCount INT,
    ReturnedRecordCount BIGINT,
    IncludeDaysMetCount BIGINT,
    MappedRecordCount BIGINT,
    UnmappedRecordCount BIGINT,
    RunStatus VARCHAR(20),
    ErrorNumber INT NULL,
    ErrorLine INT NULL,
    ErrorMessage VARCHAR(4000) NULL
);

------------------------------------------------------------
-- 18) DECLARE LOOP VARIABLES
------------------------------------------------------------

DECLARE @RangeOrder INT;
DECLARE @MaximumRangeOrder INT;
DECLARE @RangeLabel VARCHAR(100);
DECLARE @PeriodID INT;
DECLARE @EndPeriodID INT;
DECLARE @ReturnedRecordCount BIGINT;
DECLARE @IncludeDaysMetCount BIGINT;
DECLARE @MappedRecordCount BIGINT;
DECLARE @UnmappedRecordCount BIGINT;

SELECT
    @RangeOrder = MIN(RangeOrder),
    @MaximumRangeOrder = MAX(RangeOrder)
FROM @Ranges;

------------------------------------------------------------
-- 19) RUN PB AR059 FOR EACH RANGE
------------------------------------------------------------

WHILE @RangeOrder <= @MaximumRangeOrder
BEGIN
    SELECT
        @RangeLabel = RangeLabel,
        @PeriodID = AnalysisPeriodID,
        @EndPeriodID = ActivityThroughPeriodID
    FROM @Ranges
    WHERE RangeOrder = @RangeOrder;

    TRUNCATE TABLE #AR059Stage;

    SET @ReturnedRecordCount = 0;
    SET @IncludeDaysMetCount = 0;
    SET @MappedRecordCount = 0;
    SET @UnmappedRecordCount = 0;

    BEGIN TRY
        ----------------------------------------------------
        -- RUN PB AR059
        ----------------------------------------------------

        INSERT INTO #AR059Stage
        (
            FacilityID,
            FacilityName,
            InOutType,
            AccountNumber,
            SIPGCode,
            SIPGName,
            FCCode,
            FCName,
            IPCode,
            IPName,
            PostingDate,
            BillingType,
            AdmissionDate,
            DischargeDate,
            TransactionCode,
            TransactionDescription,
            TransactionAmount,
            [Status],
            RecoveryTakeback,
            DaysFromAdmission,
            IncludeExclude,
            PriorTransaction
        )
        EXEC RCA_Phys_Code.Analysis.pr_AR059_BadDebtAndInactiveAccountRecoveryPayments
            @FacilityIDs = @FacilityIDs,
            @PeriodID = @PeriodID,
            @EndPeriodID = @EndPeriodID,
            @InOutTypes = @InOutTypes,
            @Username = @Username,
            @RAC = @RAC,
            @ExcludeAccounts = @ExcludeAccounts,
            @Status = @Status,
            @PayorType = @PayorType,
            @PayorCodes = @PayorCodes,
            @SystemType = @SystemType,
            @UDFilter1 = @UDFilter1,
            @DaysThreshold = @DaysThreshold,
            @AuthMode = @AuthMode;

        ----------------------------------------------------
        -- COUNT RETURNED AND INCLUDED RECORDS
        ----------------------------------------------------

        SELECT
            @ReturnedRecordCount = COUNT_BIG(1)
        FROM #AR059Stage;

        SELECT
            @IncludeDaysMetCount = COUNT_BIG(1)
        FROM #AR059Stage
        WHERE IncludeExclude = 'Include Days Met';

        ----------------------------------------------------
        -- COUNT MAPPED RECORDS
        ----------------------------------------------------

        SELECT
            @MappedRecordCount = COUNT_BIG(1)
        FROM #AR059Stage AS AR
        INNER JOIN #ReportRegionFacilities AS RF
            ON RF.FacilityID = AR.FacilityID
        WHERE AR.IncludeExclude = 'Include Days Met';

        ----------------------------------------------------
        -- COUNT AND CAPTURE UNMAPPED RECORDS
        ----------------------------------------------------

        SELECT
            @UnmappedRecordCount = COUNT_BIG(1)
        FROM #AR059Stage AS AR
        LEFT JOIN #ReportRegionFacilities AS RF
            ON RF.FacilityID = AR.FacilityID
        WHERE AR.IncludeExclude = 'Include Days Met'
          AND RF.FacilityID IS NULL;

        INSERT INTO #AR059UnmappedFacilities
        (
            RangeOrder,
            RangeLabel,
            AnalysisPeriodID,
            ActivityThroughPeriodID,
            FacilityID,
            FacilityName,
            IncludedRecordCount
        )
        SELECT
            @RangeOrder,
            @RangeLabel,
            @PeriodID,
            @EndPeriodID,
            AR.FacilityID,
            AR.FacilityName,
            COUNT_BIG(1)
        FROM #AR059Stage AS AR
        LEFT JOIN #ReportRegionFacilities AS RF
            ON RF.FacilityID = AR.FacilityID
        WHERE AR.IncludeExclude = 'Include Days Met'
          AND RF.FacilityID IS NULL
        GROUP BY
            AR.FacilityID,
            AR.FacilityName;

        ----------------------------------------------------
        -- SAVE REPORT REGION SUMMARY
        ----------------------------------------------------

        INSERT INTO #AR059ReportRegionSummary
        (
            RangeOrder,
            RangeLabel,
            AnalysisPeriodID,
            ActivityThroughPeriodID,
            ReportRegionID,
            ReportRegion,
            FacilityCount,
            TransactionRowCount,
            DistinctAccountCount,
            NetRecoveryAmount,
            NetTakebackAmount,
            NetAmount
        )
        SELECT
            @RangeOrder,
            @RangeLabel,
            @PeriodID,
            @EndPeriodID,
            RF.ReportRegionID,
            RF.ReportRegion,
            COUNT(DISTINCT AR.FacilityID),
            COUNT_BIG(1),
            COUNT(DISTINCT AR.AccountNumber),
            SUM
            (
                CASE
                    WHEN AR.RecoveryTakeback = 'Net Recovery'
                    THEN AR.TransactionAmount
                    ELSE 0
                END
            ),
            SUM
            (
                CASE
                    WHEN AR.RecoveryTakeback = 'Net Takeback'
                    THEN AR.TransactionAmount
                    ELSE 0
                END
            ),
            SUM(AR.TransactionAmount)
        FROM #AR059Stage AS AR
        INNER JOIN #ReportRegionFacilities AS RF
            ON RF.FacilityID = AR.FacilityID
        WHERE AR.IncludeExclude = 'Include Days Met'
        GROUP BY
            RF.ReportRegionID,
            RF.ReportRegion;

        ----------------------------------------------------
        -- SAVE REPORT REGION FINANCIAL CLASS SUMMARY
        ----------------------------------------------------

        INSERT INTO #AR059FinancialClassSummary
        (
            RangeOrder,
            RangeLabel,
            AnalysisPeriodID,
            ActivityThroughPeriodID,
            ReportRegionID,
            ReportRegion,
            FinancialClassCode,
            FinancialClass,
            RecoveryTakeback,
            TransactionRowCount,
            DistinctAccountCount,
            TotalTransactionAmount
        )
        SELECT
            @RangeOrder,
            @RangeLabel,
            @PeriodID,
            @EndPeriodID,
            RF.ReportRegionID,
            RF.ReportRegion,
            AR.FCCode,
            AR.FCName,
            AR.RecoveryTakeback,
            COUNT_BIG(1),
            COUNT(DISTINCT AR.AccountNumber),
            SUM(AR.TransactionAmount)
        FROM #AR059Stage AS AR
        INNER JOIN #ReportRegionFacilities AS RF
            ON RF.FacilityID = AR.FacilityID
        WHERE AR.IncludeExclude = 'Include Days Met'
        GROUP BY
            RF.ReportRegionID,
            RF.ReportRegion,
            AR.FCCode,
            AR.FCName,
            AR.RecoveryTakeback;

        ----------------------------------------------------
        -- LOG COMPLETED RANGE
        ----------------------------------------------------

        INSERT INTO #AR059PBSummaryRunLog
        (
            RangeOrder,
            RangeLabel,
            AnalysisPeriodID,
            ActivityThroughPeriodID,
            ReportRegionCount,
            FacilityCount,
            ReturnedRecordCount,
            IncludeDaysMetCount,
            MappedRecordCount,
            UnmappedRecordCount,
            RunStatus,
            ErrorNumber,
            ErrorLine,
            ErrorMessage
        )
        VALUES
        (
            @RangeOrder,
            @RangeLabel,
            @PeriodID,
            @EndPeriodID,
            @ReportRegionCount,
            @FacilityCount,
            @ReturnedRecordCount,
            @IncludeDaysMetCount,
            @MappedRecordCount,
            @UnmappedRecordCount,
            'Completed',
            NULL,
            NULL,
            NULL
        );
    END TRY

    BEGIN CATCH
        ----------------------------------------------------
        -- LOG ERROR AND CONTINUE TO NEXT RANGE
        ----------------------------------------------------

        INSERT INTO #AR059PBSummaryRunLog
        (
            RangeOrder,
            RangeLabel,
            AnalysisPeriodID,
            ActivityThroughPeriodID,
            ReportRegionCount,
            FacilityCount,
            ReturnedRecordCount,
            IncludeDaysMetCount,
            MappedRecordCount,
            UnmappedRecordCount,
            RunStatus,
            ErrorNumber,
            ErrorLine,
            ErrorMessage
        )
        VALUES
        (
            @RangeOrder,
            @RangeLabel,
            @PeriodID,
            @EndPeriodID,
            @ReportRegionCount,
            @FacilityCount,
            @ReturnedRecordCount,
            @IncludeDaysMetCount,
            @MappedRecordCount,
            @UnmappedRecordCount,
            'Error',
            ERROR_NUMBER(),
            ERROR_LINE(),
            ERROR_MESSAGE()
        );
    END CATCH;

    SET @RangeOrder = @RangeOrder + 1;
END;

------------------------------------------------------------
-- 20) OVERALL SIX-RANGE TOTALS
------------------------------------------------------------

SELECT
    RangeOrder,
    RangeLabel,
    AnalysisPeriodID,
    ActivityThroughPeriodID,
    SUM(TransactionRowCount) AS TransactionRowCount,
    SUM(NetRecoveryAmount) AS NetRecoveryAmount,
    SUM(NetTakebackAmount) AS NetTakebackAmount,
    SUM(NetAmount) AS NetAmount
FROM #AR059ReportRegionSummary
GROUP BY
    RangeOrder,
    RangeLabel,
    AnalysisPeriodID,
    ActivityThroughPeriodID
ORDER BY RangeOrder;

------------------------------------------------------------
-- 21) REPORT REGION SUMMARY
------------------------------------------------------------

SELECT
    RangeOrder,
    RangeLabel,
    AnalysisPeriodID,
    ActivityThroughPeriodID,
    ReportRegion,
    FacilityCount,
    TransactionRowCount,
    DistinctAccountCount,
    NetRecoveryAmount,
    NetTakebackAmount,
    NetAmount
FROM #AR059ReportRegionSummary
ORDER BY
    RangeOrder,
    ReportRegion;

------------------------------------------------------------
-- 22) REPORT REGION FINANCIAL CLASS SUMMARY
--
-- FINAL PB DELIVERABLE
------------------------------------------------------------

SELECT
    RangeOrder,
    RangeLabel,
    AnalysisPeriodID,
    ActivityThroughPeriodID,
    ReportRegion,
    FinancialClassCode,
    FinancialClass,
    RecoveryTakeback,
    TransactionRowCount,
    DistinctAccountCount,
    TotalTransactionAmount
FROM #AR059FinancialClassSummary
ORDER BY
    RangeOrder,
    ReportRegion,
    FinancialClass,
    RecoveryTakeback;

------------------------------------------------------------
-- 23) UNMAPPED FACILITY DIAGNOSTICS
--
-- Ideally returns no rows
------------------------------------------------------------

SELECT
    RangeOrder,
    RangeLabel,
    AnalysisPeriodID,
    ActivityThroughPeriodID,
    FacilityID,
    FacilityName,
    IncludedRecordCount
FROM #AR059UnmappedFacilities
ORDER BY
    RangeOrder,
    FacilityName,
    FacilityID;

------------------------------------------------------------
-- 24) RUN LOG
--
-- All six ranges should show Completed.
-- ReconciliationDifference should equal 0.
------------------------------------------------------------

SELECT
    RangeOrder,
    RangeLabel,
    AnalysisPeriodID,
    ActivityThroughPeriodID,
    ReportRegionCount,
    FacilityCount,
    ReturnedRecordCount,
    IncludeDaysMetCount,
    MappedRecordCount,
    UnmappedRecordCount,
    IncludeDaysMetCount
        - MappedRecordCount
        - UnmappedRecordCount AS ReconciliationDifference,
    RunStatus,
    ErrorNumber,
    ErrorLine,
    ErrorMessage
FROM #AR059PBSummaryRunLog
ORDER BY RangeOrder;
