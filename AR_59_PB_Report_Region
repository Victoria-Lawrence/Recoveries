            ELSE 0
        END
    ) AS NetRecoveryAmount,

    SUM
    (
        CASE
            WHEN RecoveryTakeback = 'Net Takeback'
            THEN TransactionAmount
            ELSE 0
        END
    ) AS NetTakebackAmount,

    SUM(TransactionAmount) AS NetAmount

FROM #AR059GroupDetail

GROUP BY
    RangeOrder,
    RangeLabel,
    AnalysisPeriodID,
    ActivityThroughPeriodID,
    GroupCategoryID,
    GroupCategoryName,
    Specialty

ORDER BY
    RangeOrder,
    Specialty;


------------------------------------------------------------
-- 18) RANGE, SPECIALTY, AND AU SUMMARY
------------------------------------------------------------

SELECT
    RangeOrder,
    RangeLabel,
    AnalysisPeriodID,
    ActivityThroughPeriodID,

    GroupCategoryID,
    GroupCategoryName,

    Specialty,
