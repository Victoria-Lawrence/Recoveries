------------------------------------------------------------
-- 3) VALIDATE REPORT REGION DEFINITIONS
--
-- This ensures that the IDs still exist and that their
-- names match the verified Report Region names.
------------------------------------------------------------

IF EXISTS
(
    SELECT 1
    FROM @ReportRegions AS RR

    LEFT JOIN Analysis.dimGroupCategory AS GC
        ON GC.GroupCategoryID = RR.ReportRegionID

    WHERE GC.GroupCategoryID IS NULL
       OR LTRIM(RTRIM(GC.GroupCategoryName))
            <> RR.ExpectedReportRegion
)
BEGIN

    SELECT
        RR.ReportRegionID,
        RR.ExpectedReportRegion,
        GC.GroupCategoryName AS CurrentGroupCategoryName

    FROM @ReportRegions AS RR

    LEFT JOIN Analysis.dimGroupCategory AS GC
        ON GC.GroupCategoryID = RR.ReportRegionID

    WHERE GC.GroupCategoryID IS NULL
       OR LTRIM(RTRIM(GC.GroupCategoryName))
            <> RR.ExpectedReportRegion

    ORDER BY
        RR.ReportRegionID;

    THROW 50001,
        'One or more PB Report Region IDs are missing or have a different name.',
        1;

END;


