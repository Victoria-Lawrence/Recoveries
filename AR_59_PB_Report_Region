------------------------------------------------------------
-- 19) FINANCIAL CLASS SUMMARY
------------------------------------------------------------

SELECT
    RangeOrder,
    RangeLabel,
    AnalysisPeriodID,
    ActivityThroughPeriodID,

    Specialty,

    FCCode AS FinancialClassCode,
    FCName AS FinancialClass,

    RecoveryTakeback,

    COUNT_BIG(1) AS TransactionRowCount,
    COUNT(DISTINCT AccountNumber) AS DistinctAccountCount,
    SUM(TransactionAmount) AS TotalTransactionAmount

FROM #AR059GroupDetail

GROUP BY
    RangeOrder,
    RangeLabel,
    AnalysisPeriodID,
    ActivityThroughPeriodID,
    Specialty,
    FCCode,
    FCName,
    RecoveryTakeback

ORDER BY
    RangeOrder,
    Specialty,
    FCName,
    RecoveryTakeback;


------------------------------------------------------------
-- 20) RUN LOG
--
-- All six ranges should show Completed.
------------------------------------------------------------

SELECT
    RangeOrder,
    RangeLabel,
    AnalysisPeriodID,
    ActivityThroughPeriodID,

    GroupCategoryID,
    GroupCategoryName,

    FacilityCount,
    ReturnedRecordCount,
    IncludeDaysMetCount,
    FinalDetailCount,

    RunStatus,
    ErrorNumber,
    ErrorLine,
    ErrorMessage

FROM #AR059RunLog

ORDER BY
    RangeOrder;


