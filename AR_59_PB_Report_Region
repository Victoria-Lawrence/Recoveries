
USE [RCA_Phys_Code];
GO

SET NOCOUNT ON;
SET XACT_ABORT ON;


/*==============================================================
  HTPN WO&M AR059 RECOVERY DETAIL
  Report Group Selection:
      GroupCategoryID = 1018

  This version:
      1. Uses the HTPN WO&M report-group facility mapping.
      2. Retains Specialty and AU from Facility Structure.
      3. Runs the existing AR059 procedure for six ranges.
      4. Returns summary, diagnostics, and complete detail.
==============================================================*/


------------------------------------------------------------
-- 1) GENERAL SETTINGS
------------------------------------------------------------

DECLARE @Username VARCHAR(50) = 'BHCS\vstevens';

DECLARE @GroupCategoryID INT = 1018;
DECLARE @GroupCategoryName VARCHAR(128);

DECLARE @InOutTypes VARCHAR(20) = 'Outpatient';
DECLARE @RAC INT = 1;
DECLARE @ExcludeAccounts INT = 0;
DECLARE @Status VARCHAR(20) = 'BAD DEBT,INACTIVE';
DECLARE @PayorType VARCHAR(31) = 'Financial Class';

/*
    NULL means all financial classes/payors.
*/
DECLARE @PayorCodes VARCHAR(MAX) = NULL;

DECLARE @SystemType VARCHAR(MAX) = NULL;
DECLARE @UDFilter1 VARCHAR(MAX) = NULL;
DECLARE @DaysThreshold INT = 30;
DECLARE @AuthMode VARCHAR(10) = 'AD';


------------------------------------------------------------
-- 2) SIX RECOVERY RANGES
--
-- AnalysisPeriodID:
--     Analysis Date selected in Crowe
--
-- ActivityThroughPeriodID:
--     Activity Through date selected in Crowe
------------------------------------------------------------

DECLARE @Ranges TABLE
(
    RangeOrder INT NOT NULL PRIMARY KEY,
    RangeLabel VARCHAR(100) NOT NULL,
    AnalysisPeriodID INT NOT NULL,
    ActivityThroughPeriodID INT NOT NULL
);

INSERT INTO @Ranges
(
    RangeOrder,
    RangeLabel,
    AnalysisPeriodID,
    ActivityThroughPeriodID
)
VALUES
    (1, 'Range 1', 20250731, 20260731),
    (2, 'Range 2', 20250630, 20260630),
    (3, 'Range 3', 20250531, 20260531),
    (4, 'Range 4', 20250430, 20260430),
    (5, 'Range 5', 20250930, 20260930),
    (6, 'Range 6', 20250831, 20260831);


------------------------------------------------------------
-- 3) VALIDATE RANGE DATES
------------------------------------------------------------

IF EXISTS
(
    SELECT 1
    FROM @Ranges
    WHERE AnalysisPeriodID >= ActivityThroughPeriodID
)
BEGIN
    THROW 50001,
          'Each Analysis Period must be earlier than its Activity Through Period.',
          1;
END;


------------------------------------------------------------
-- 4) GET REPORT-GROUP NAME
------------------------------------------------------------

SELECT
    @GroupCategoryName = GC.GroupCategoryName
FROM Analysis.dimGroupCategory AS GC
WHERE GC.GroupCategoryID = @GroupCategoryID;

IF @GroupCategoryName IS NULL
BEGIN
    THROW 50002,
          'GroupCategoryID 1018 was not found in Analysis.dimGroupCategory.',
          1;
END;


------------------------------------------------------------
-- 5) LOAD AUTHORIZED FACILITY STRUCTURE
------------------------------------------------------------

IF OBJECT_ID('tempdb..#FacilityStructure') IS NOT NULL
    DROP TABLE #FacilityStructure;

CREATE TABLE #FacilityStructure
(
    MaxFacilityLevel INT,

    FacilityID1 INT,
    FacilityLevelType1 VARCHAR(100),
    FacilityCode1 VARCHAR(100),
    FacilityName1 VARCHAR(255),

    FacilityID2 INT,
    FacilityLevelType2 VARCHAR(100),
    FacilityCode2 VARCHAR(100),
    FacilityName2 VARCHAR(255),

    FacilityID3 INT,
    FacilityLevelType3 VARCHAR(100),
    FacilityCode3 VARCHAR(100),
    FacilityName3 VARCHAR(255),

    FacilityID4 INT,
    FacilityLevelType4 VARCHAR(100),
    FacilityCode4 VARCHAR(100),
    FacilityName4 VARCHAR(255),

    FacilityID5 INT NULL,
    FacilityLevelType5 VARCHAR(100) NULL,
    FacilityCode5 VARCHAR(100) NULL,
    FacilityName5 VARCHAR(255) NULL,

    FacilityID6 INT NULL,
    FacilityLevelType6 VARCHAR(100) NULL,
    FacilityCode6 VARCHAR(100) NULL,
    FacilityName6 VARCHAR(255) NULL
);

INSERT INTO #FacilityStructure
EXEC RCA_Phys_Code.Analysis.p_MappingDataFacilityStructure
    @UserName = @Username;


------------------------------------------------------------
-- 6) CREATE HTPN WO&M REPORT-GROUP FACILITY MAPPING
------------------------------------------------------------

IF OBJECT_ID('tempdb..#GroupFacilities') IS NOT NULL
    DROP TABLE #GroupFacilities;

CREATE TABLE #GroupFacilities
(
    GroupCategoryID INT NOT NULL,
    GroupCategoryName VARCHAR(128) NULL,
    Specialty VARCHAR(128) NULL,
    AU VARCHAR(9) NULL,
    FacilityID INT NOT NULL,
    FacilityCode VARCHAR(100) NULL,
    FacilityName VARCHAR(255) NULL
);

INSERT INTO #GroupFacilities
(
    GroupCategoryID,
    GroupCategoryName,
    Specialty,
    AU,
    FacilityID,
    FacilityCode,
    FacilityName
)
SELECT DISTINCT
    @GroupCategoryID,
    @GroupCategoryName,
    LTRIM(RTRIM(FS.FacilityName2)),
    LEFT(LTRIM(FS.FacilityName1), 9),
    FS.FacilityID1,
    FS.FacilityCode1,
    FS.FacilityName1
FROM Analysis.FacilityGroup AS FG
INNER JOIN #FacilityStructure AS FS
    ON FS.FacilityID1 = FG.FacilityID
WHERE FG.GroupCategoryID = @GroupCategoryID
  AND FS.FacilityID1 IS NOT NULL;


------------------------------------------------------------
-- 7) VERIFY REPORT-GROUP FACILITIES
------------------------------------------------------------

IF NOT EXISTS
(
    SELECT 1
    FROM #GroupFacilities
)
BEGIN
    THROW 50003,
          'No authorized facilities were found for GroupCategoryID 1018.',
          1;
END;


------------------------------------------------------------
-- 8) CREATE ONE MAPPING ROW PER FACILITY
--
-- This prevents AR059 rows from duplicating if FacilityGroup or
-- FacilityStructure contains duplicate mappings.
------------------------------------------------------------

IF OBJECT_ID('tempdb..#GroupFacilityMapping') IS NOT NULL
    DROP TABLE #GroupFacilityMapping;

CREATE TABLE #GroupFacilityMapping
(
    GroupCategoryID INT NOT NULL,
    GroupCategoryName VARCHAR(128) NULL,
    Specialty VARCHAR(128) NULL,
    AU VARCHAR(9) NULL,
    FacilityID INT NOT NULL,
    FacilityCode VARCHAR(100) NULL,
    FacilityName VARCHAR(255) NULL
);

;WITH RankedFacilityMapping AS
(
    SELECT
        GF.GroupCategoryID,
        GF.GroupCategoryName,
        GF.Specialty,
        GF.AU,
        GF.FacilityID,
        GF.FacilityCode,
        GF.FacilityName,

        ROW_NUMBER() OVER
        (
            PARTITION BY GF.FacilityID
            ORDER BY
                GF.Specialty,
                GF.FacilityName,
                GF.FacilityCode
        ) AS MappingRow

    FROM #GroupFacilities AS GF
)
INSERT INTO #GroupFacilityMapping
(
    GroupCategoryID,
    GroupCategoryName,
    Specialty,
    AU,
    FacilityID,
    FacilityCode,
    FacilityName
)
SELECT
    GroupCategoryID,
    GroupCategoryName,
    Specialty,
    AU,
    FacilityID,
    FacilityCode,
    FacilityName
FROM RankedFacilityMapping
WHERE MappingRow = 1;


------------------------------------------------------------
-- 9) BUILD COMMA-SEPARATED FACILITY LIST
------------------------------------------------------------

DECLARE @FacilityIDs VARCHAR(MAX);
DECLARE @FacilityCount INT;

SELECT
    @FacilityIDs =
        STUFF
        (
            (
                SELECT
                    ',' + CAST(F.FacilityID AS VARCHAR(20))
                FROM
                (
                    SELECT DISTINCT
                        FacilityID
                    FROM #GroupFacilityMapping
                ) AS F
                ORDER BY
                    F.FacilityID
                FOR XML PATH(''), TYPE
            ).value('.', 'VARCHAR(MAX)'),
            1,
            1,
            ''
        );

SELECT
    @FacilityCount = COUNT(DISTINCT FacilityID)
FROM #GroupFacilityMapping;

IF NULLIF(LTRIM(RTRIM(@FacilityIDs)), '') IS NULL
BEGIN
    THROW 50004,
          'The HTPN WO&M FacilityID list is empty.',
          1;
END;


------------------------------------------------------------
-- 10) FACILITY VALIDATION
------------------------------------------------------------

SELECT
    GroupCategoryID,
    GroupCategoryName,
    Specialty,
    AU,
    FacilityID,
    FacilityCode,
    FacilityName
FROM #GroupFacilityMapping
ORDER BY
    Specialty,
    AU,
    FacilityName,
    FacilityID;


SELECT
    @GroupCategoryID AS GroupCategoryID,
    @GroupCategoryName AS GroupCategoryName,
    @FacilityCount AS FacilityCount,
    @FacilityIDs AS FacilityIDList;


