--
-- This drives the final requested PB deliverable.
------------------------------------------------------------

IF OBJECT_ID('tempdb..#AR059FinancialClassSummary') IS NOT NULL
    DROP TABLE #AR059FinancialClassSummary;

CREATE TABLE #AR059FinancialClassSummary
(
    RangeOrder INT NOT NULL,
    RangeLabel VARCHAR(100) NOT NULL,
    AnalysisPeriodID INT NOT NULL,
    ActivityThroughPeriodID INT NOT NULL,
    ReportRegionID INT NOT NULL,
    ReportRegion VARCHAR(128) NOT NULL,
    FinancialClassCode VARCHAR(50) NULL,
    FinancialClass VARCHAR(256) NULL,
