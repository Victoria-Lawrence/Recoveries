    FacilityCode6 VARCHAR(100) NULL,
    FacilityName6 VARCHAR(255) NULL
);

INSERT INTO #FacilityStructure
EXEC RCA_Phys_Code.Analysis.p_MappingDataFacilityStructure
    @UserName = @Username;

------------------------------------------------------------
-- 7) CREATE REPORT REGION FACILITY MAPPING
------------------------------------------------------------

IF OBJECT_ID('tempdb..#ReportRegionFacilities') IS NOT NULL
    DROP TABLE #ReportRegionFacilities;

CREATE TABLE #ReportRegionFacilities
(
    ReportRegionID INT NOT NULL,
    ReportRegion VARCHAR(128) NOT NULL,
    FacilityID INT NOT NULL,
    FacilityCode VARCHAR(100) NULL,
    FacilityName VARCHAR(255) NULL
);

INSERT INTO #ReportRegionFacilities
(
    ReportRegionID,
    ReportRegion,
    FacilityID,
    FacilityCode,
    FacilityName
)
SELECT DISTINCT
    RR.ReportRegionID,
    RR.ReportRegion,
    FS.FacilityID1,
    FS.FacilityCode1,
    FS.FacilityName1
FROM @ReportRegions AS RR
INNER JOIN Analysis.FacilityGroup AS FG
    ON FG.GroupCategoryID = RR.ReportRegionID
INNER JOIN #FacilityStructure AS FS
    ON FS.FacilityID1 = FG.FacilityID
WHERE FS.FacilityID1 IS NOT NULL;

------------------------------------------------------------
-- 8) VERIFY FACILITY MAPPING
------------------------------------------------------------

IF NOT EXISTS
(
    SELECT 1
    FROM #ReportRegionFacilities
)
BEGIN
    THROW 50003,
        'No authorized PB facilities were found for the Report Regions.',
        1;
END;

------------------------------------------------------------
-- 9) CHECK FOR MULTIPLE REPORT REGION ASSIGNMENTS
------------------------------------------------------------

IF EXISTS
(
    SELECT FacilityID
    FROM #ReportRegionFacilities
    GROUP BY FacilityID
    HAVING COUNT(DISTINCT ReportRegionID) > 1
)
BEGIN
    SELECT
        FacilityID,
        MAX(FacilityCode) AS FacilityCode,
        MAX(FacilityName) AS FacilityName,
        COUNT(DISTINCT ReportRegionID) AS ReportRegionCount
    FROM #ReportRegionFacilities
    GROUP BY FacilityID
    HAVING COUNT(DISTINCT ReportRegionID) > 1
    ORDER BY FacilityID;

    THROW 50004,
        'One or more PB facilities are assigned to multiple Report Regions.',
        1;
END;

------------------------------------------------------------
-- 10) REPORT REGION FACILITY VALIDATION
------------------------------------------------------------

SELECT
    ReportRegionID,
    ReportRegion,
    COUNT(DISTINCT FacilityID) AS FacilityCount
FROM #ReportRegionFacilities
GROUP BY
    ReportRegionID,
    ReportRegion
ORDER BY ReportRegion;

------------------------------------------------------------
-- 11) BUILD COMPLETE PB FACILITY LIST
------------------------------------------------------------

DECLARE @FacilityIDs VARCHAR(MAX);
DECLARE @FacilityCount INT;
DECLARE @ReportRegionCount INT;

SELECT
    @FacilityIDs =
        STUFF
        (
            (
                SELECT ',' + CAST(F.FacilityID AS VARCHAR(20))
                FROM
                (
                    SELECT DISTINCT FacilityID
                    FROM #ReportRegionFacilities
                ) AS F
                ORDER BY F.FacilityID
                FOR XML PATH(''), TYPE
            ).value('.', 'VARCHAR(MAX)'),
            1,
            1,
            ''
        );

SELECT
    @FacilityCount = COUNT(DISTINCT FacilityID),
    @ReportRegionCount = COUNT(DISTINCT ReportRegionID)
FROM #ReportRegionFacilities;

IF NULLIF(LTRIM(RTRIM(@FacilityIDs)), '') IS NULL
BEGIN
    THROW 50005,
        'The PB Report Region FacilityID list is empty.',
        1;
END;

------------------------------------------------------------
-- 12) OVERALL SELECTION VALIDATION
------------------------------------------------------------

SELECT
    'PB Report Region' AS ProcessingScope,
    @ReportRegionCount AS ReportRegionCount,
    @FacilityCount AS FacilityCount,
    @FacilityIDs AS FacilityIDList;

