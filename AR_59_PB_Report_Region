------------------------------------------------------------
-- 3) VALIDATE REPORT REGION NAMES
------------------------------------------------------------

IF EXISTS
(
    SELECT 1
    FROM @ReportRegions AS RR
    LEFT JOIN Analysis.dimGroupCategory AS GC
        ON GC.GroupCategoryID = RR.ReportRegionID
    WHERE GC.GroupCategoryID IS NULL
       OR LTRIM(RTRIM(GC.GroupCategoryName)) <> RR.ReportRegion
)
BEGIN
    SELECT
        RR.ReportRegionID,
        RR.ReportRegion AS ExpectedReportRegion,
        GC.GroupCategoryName AS CurrentGroupCategoryName
    FROM @ReportRegions AS RR
    LEFT JOIN Analysis.dimGroupCategory AS GC
        ON GC.GroupCategoryID = RR.ReportRegionID
    WHERE GC.GroupCategoryID IS NULL
       OR LTRIM(RTRIM(GC.GroupCategoryName)) <> RR.ReportRegion
    ORDER BY RR.ReportRegionID;

    THROW 50001,
        'One or more Report Region IDs are missing or have changed names.',
        1;
END;

