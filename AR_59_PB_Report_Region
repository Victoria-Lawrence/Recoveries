CREATE TABLE #FacilitiesWithoutReportRegion
(
    Specialty VARCHAR(128) NULL,
    AU VARCHAR(9) NULL,
    FacilityID INT NOT NULL,
    FacilityCode VARCHAR(100) NULL,
    FacilityName VARCHAR(255) NULL
);

INSERT INTO #FacilitiesWithoutReportRegion
(
    Specialty,
    AU,
    FacilityID,
    FacilityCode,
    FacilityName
)
SELECT
    APB.Specialty,
    APB.AU,
    APB.FacilityID,
    APB.FacilityCode,
    APB.FacilityName

FROM #AuthorizedPBFacilities AS APB

LEFT JOIN #PBReportRegionMapping AS RM
    ON RM.FacilityID = APB.FacilityID

WHERE RM.FacilityID IS NULL;


------------------------------------------------------------
-- 13) VALIDATE REPORT REGION ASSIGNMENT
--
-- Stop if one PB facility belongs to multiple Report Regions.
-- Otherwise the AR059 detail would duplicate when joined.
------------------------------------------------------------

IF EXISTS
(
    SELECT
        FacilityID

    FROM #PBReportRegionMapping

    GROUP BY
        FacilityID

    HAVING COUNT(DISTINCT ReportRegionID) > 1
)
BEGIN

    THROW 50004,
        'One or more PB facilities are assigned to multiple Report Regions. Review the diagnostic result above.',
        1;

END;

------------------------------------------------------------
-- 14) BUILD COMMA-SEPARATED FACILITY LIST
------------------------------------------------------------

DECLARE @FacilityIDs VARCHAR(MAX);
DECLARE @FacilityCount INT;
DECLARE @ReportRegionCount INT;
DECLARE @SpecialtyCount INT;

SELECT
    @FacilityIDs =
        STUFF
        (
            (
                SELECT
                    ',' + CAST(F.FacilityID AS VARCHAR(20))

                FROM
                (
                    SELECT DISTINCT
                        FacilityID

                    FROM #PBReportRegionMapping
                ) AS F

                ORDER BY
                    F.FacilityID

                FOR XML PATH(''), TYPE

            ).value('.', 'VARCHAR(MAX)'),

            1,
            1,
            ''
        );


SELECT
    @FacilityCount =
        COUNT(DISTINCT FacilityID),

    @ReportRegionCount =
        COUNT(DISTINCT ReportRegionID),

    @SpecialtyCount =
        COUNT
        (
            DISTINCT CASE
                WHEN Specialty IS NOT NULL
                THEN Specialty
            END
        )

FROM #PBReportRegionMapping;


IF NULLIF(LTRIM(RTRIM(@FacilityIDs)), '') IS NULL
BEGIN

    THROW 50006,
        'The PB Report Region FacilityID list is empty.',
        1;

END;


------------------------------------------------------------
-- 15) REPORT REGION MAPPING VALIDATION
------------------------------------------------------------

SELECT
    ReportRegionID,
    ReportRegion,

    Specialty,
    AU,

    FacilityID,
    FacilityCode,
    FacilityName

FROM #PBReportRegionMapping

ORDER BY
    ReportRegion,
    Specialty,
    AU,
    FacilityName,
    FacilityID;


------------------------------------------------------------
-- 16) REPORT REGION FACILITY COUNTS
------------------------------------------------------------

SELECT
    ReportRegionID,
    ReportRegion,

    COUNT(DISTINCT FacilityID) AS FacilityCount,

    COUNT
    (
        DISTINCT CASE
            WHEN Specialty IS NOT NULL
            THEN Specialty
        END
    ) AS SpecialtyCount

FROM #PBReportRegionMapping

GROUP BY
    ReportRegionID,
    ReportRegion

ORDER BY
    ReportRegion;


------------------------------------------------------------
-- 17) AUTHORIZED FACILITIES WITHOUT REPORT REGION
--
-- Review this result carefully.
--
-- An empty result means every authorized PB facility was
-- assigned to one of the verified Report Regions.
------------------------------------------------------------

SELECT
