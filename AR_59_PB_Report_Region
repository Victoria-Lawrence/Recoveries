    @SpecialtyCount AS SpecialtyCount,

    @FacilityCount AS FacilityCount,

    (
        SELECT COUNT_BIG(1)
        FROM #FacilitiesWithoutReportRegion
    ) AS AuthorizedFacilitiesWithoutReportRegion,

    @FacilityIDs AS FacilityIDList;


