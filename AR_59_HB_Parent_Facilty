-- 13) CREATE UNMAPPED FACILITY DIAGNOSTIC TABLE
--
-- This captures returned FacilityIDs that do not match a
-- SubFacilityID in the HB hierarchy.
------------------------------------------------------------

IF OBJECT_ID('tempdb..#AR059UnmappedFacilities') IS NOT NULL
    DROP TABLE #AR059UnmappedFacilities;

CREATE TABLE #AR059UnmappedFacilities
(
    RangeOrder INT,
    RangeLabel VARCHAR(100),
    AnalysisPeriodID INT,
    ActivityThroughPeriodID INT,

    FacilityID INT,
    FacilityName VARCHAR(256),

    ReturnedRecordCount BIGINT
);


------------------------------------------------------------
-- 14) CREATE RUN LOG
------------------------------------------------------------

IF OBJECT_ID('tempdb..#AR059RunLog') IS NOT NULL
    DROP TABLE #AR059RunLog;

CREATE TABLE #AR059RunLog
(
    RangeOrder INT,
    RangeLabel VARCHAR(100),
    AnalysisPeriodID INT,
    ActivityThroughPeriodID INT,

    RegionCount INT,
    ParentFacilityCount INT,
    SubFacilityCount INT,

    ReturnedRecordCount BIGINT,
    IncludeDaysMetCount BIGINT,
    MappedDetailCount BIGINT,
    UnmappedDetailCount BIGINT,

    RunStatus VARCHAR(20),

    ErrorNumber INT NULL,
    ErrorLine INT NULL,
    ErrorMessage VARCHAR(4000) NULL
);


------------------------------------------------------------
-- 15) DECLARE LOOP VARIABLES
------------------------------------------------------------

DECLARE @RangeOrder INT;

DECLARE @MaximumRangeOrder INT;

DECLARE @RangeLabel VARCHAR(100);

DECLARE @PeriodID INT;

DECLARE @EndPeriodID INT;

DECLARE @ReturnedRecordCount BIGINT;

DECLARE @IncludeDaysMetCount BIGINT;

DECLARE @MappedDetailCount BIGINT;

DECLARE @UnmappedDetailCount BIGINT;

SELECT
    @RangeOrder = MIN(RangeOrder),
    @MaximumRangeOrder = MAX(RangeOrder)
FROM @Ranges;


------------------------------------------------------------
-- 16) RUN HB AR059 FOR EACH RANGE
------------------------------------------------------------

WHILE @RangeOrder <= @MaximumRangeOrder
BEGIN

    --------------------------------------------------------
    -- Get current range
    --------------------------------------------------------

    SELECT
        @RangeLabel = RangeLabel,
        @PeriodID = AnalysisPeriodID,
        @EndPeriodID = ActivityThroughPeriodID
    FROM @Ranges
    WHERE RangeOrder = @RangeOrder;


    --------------------------------------------------------
    -- Reset staging table and counts
    --------------------------------------------------------

    TRUNCATE TABLE #AR059Stage;

    SET @ReturnedRecordCount = 0;

    SET @IncludeDaysMetCount = 0;

    SET @MappedDetailCount = 0;

    SET @UnmappedDetailCount = 0;


    BEGIN TRY

        ----------------------------------------------------
        -- Run the HB AR059 stored procedure
        ----------------------------------------------------

        INSERT INTO #AR059Stage
        (
            FacilityID,
            FacilityName,
            InOutType,
            AccountNumber,
            SIPGCode,
            SIPGName,
            FCCode,
            FCName,
            IPCode,
            IPName,
            PostingDate,
            BillingType,
            AdmissionDate,
            DischargeDate,
            TransactionCode,
            TransactionDescription,
            TransactionAmount,
            [Status],
            RecoveryTakeback,
            DaysFromAdmission,
            IncludeExclude,
            PriorTransaction
        )
        EXEC RCA_Code.Analysis.pr_AR059_BadDebtAndInactiveAccountRecoveryPayments
            @FacilityIDs = @FacilityIDs,
            @PeriodID = @PeriodID,
            @EndPeriodID = @EndPeriodID,
            @InOutTypes = @InOutTypes,
            @Username = @Username,
            @RAC = @RAC,
            @ExcludeAccounts = @ExcludeAccounts,
            @Status = @Status,
            @PayorType = @PayorType,
            @PayorCodes = @PayorCodes,
            @SystemType = @SystemType,
            @UDFilter1 = @UDFilter1,
            @DaysThreshold = @DaysThreshold,
            @AuthMode = @AuthMode;


        ----------------------------------------------------
        -- Count returned and included records
        ----------------------------------------------------

        SELECT
            @ReturnedRecordCount = COUNT_BIG(1)
        FROM #AR059Stage;


        SELECT
            @IncludeDaysMetCount = COUNT_BIG(1)
        FROM #AR059Stage
        WHERE IncludeExclude = 'Include Days Met';


        ----------------------------------------------------
        -- Capture included rows with unmapped Facility IDs
        ----------------------------------------------------

        INSERT INTO #AR059UnmappedFacilities
        (
            RangeOrder,
            RangeLabel,
            AnalysisPeriodID,
            ActivityThroughPeriodID,
            FacilityID,
            FacilityName,
            ReturnedRecordCount
        )
        SELECT
            @RangeOrder,
            @RangeLabel,
            @PeriodID,
            @EndPeriodID,
            AR.FacilityID,
            AR.FacilityName,
            COUNT_BIG(1)

        FROM #AR059Stage AS AR

        LEFT JOIN #HBFacilityMapping AS HM
            ON HM.SubFacilityID = AR.FacilityID

        WHERE AR.IncludeExclude = 'Include Days Met'
          AND HM.SubFacilityID IS NULL

        GROUP BY
            AR.FacilityID,
            AR.FacilityName;


        SELECT
            @UnmappedDetailCount = COUNT_BIG(1)
        FROM #AR059Stage AS AR

        LEFT JOIN #HBFacilityMapping AS HM
            ON HM.SubFacilityID = AR.FacilityID

        WHERE AR.IncludeExclude = 'Include Days Met'
          AND HM.SubFacilityID IS NULL;


        ----------------------------------------------------
        -- Save mapped included transaction detail
        ----------------------------------------------------

        INSERT INTO #AR059HBDetail
        (
            RangeOrder,
            RangeLabel,
            AnalysisPeriodID,
            ActivityThroughPeriodID,

            RegionID,
            RegionCode,
            Region,

            ParentFacilityID,
            ParentFacilityCode,
            ParentFacility,

            MappedSubFacilityID,
            MappedSubFacilityCode,
            MappedSubFacility,

            FacilityID,
            FacilityName,

            InOutType,
            AccountNumber,

            SIPGCode,
            SIPGName,

            FCCode,
            FCName,

            IPCode,
            IPName,

            PostingDate,
            BillingType,
            AdmissionDate,
            DischargeDate,

            TransactionCode,
            TransactionDescription,
            TransactionAmount,

            [Status],
            RecoveryTakeback,
            DaysFromAdmission,
            IncludeExclude,
            PriorTransaction
        )
        SELECT
            @RangeOrder,
            @RangeLabel,
            @PeriodID,
            @EndPeriodID,

            HM.RegionID,
            HM.RegionCode,
            HM.Region,

            HM.ParentFacilityID,
            HM.ParentFacilityCode,
            HM.ParentFacility,

            HM.SubFacilityID,
            HM.SubFacilityCode,
            HM.SubFacility,

            AR.FacilityID,
            AR.FacilityName,

            AR.InOutType,
            AR.AccountNumber,

            AR.SIPGCode,
            AR.SIPGName,

            AR.FCCode,
            AR.FCName,

            AR.IPCode,
            AR.IPName,

            AR.PostingDate,
            AR.BillingType,
            AR.AdmissionDate,
            AR.DischargeDate,

            AR.TransactionCode,
            AR.TransactionDescription,
            AR.TransactionAmount,

            AR.[Status],
            AR.RecoveryTakeback,
            AR.DaysFromAdmission,
            AR.IncludeExclude,
            AR.PriorTransaction

        FROM #AR059Stage AS AR

        INNER JOIN #HBFacilityMapping AS HM
            ON HM.SubFacilityID = AR.FacilityID

        WHERE AR.IncludeExclude = 'Include Days Met';


        SET @MappedDetailCount = @@ROWCOUNT;


        ----------------------------------------------------
        -- Log successful range
        ----------------------------------------------------

        INSERT INTO #AR059RunLog
        (
            RangeOrder,
            RangeLabel,
            AnalysisPeriodID,
            ActivityThroughPeriodID,

            RegionCount,
            ParentFacilityCount,
            SubFacilityCount,

            ReturnedRecordCount,
            IncludeDaysMetCount,
            MappedDetailCount,
            UnmappedDetailCount,

            RunStatus,

            ErrorNumber,
            ErrorLine,
            ErrorMessage
        )
        VALUES
        (
            @RangeOrder,
            @RangeLabel,
            @PeriodID,
            @EndPeriodID,

            @RegionCount,
            @ParentFacilityCount,
            @SubFacilityCount,

            @ReturnedRecordCount,
            @IncludeDaysMetCount,
            @MappedDetailCount,
            @UnmappedDetailCount,

            'Completed',

            NULL,
            NULL,
            NULL
        );

    END TRY

    BEGIN CATCH

        ----------------------------------------------------
        -- Log error and continue to the next range
        ----------------------------------------------------

        INSERT INTO #AR059RunLog
        (
            RangeOrder,
            RangeLabel,
            AnalysisPeriodID,
            ActivityThroughPeriodID,

            RegionCount,
            ParentFacilityCount,
            SubFacilityCount,

            ReturnedRecordCount,
            IncludeDaysMetCount,
            MappedDetailCount,
            UnmappedDetailCount,

            RunStatus,

            ErrorNumber,
            ErrorLine,
            ErrorMessage
        )
        VALUES
        (
            @RangeOrder,
            @RangeLabel,
            @PeriodID,
            @EndPeriodID,

            @RegionCount,
            @ParentFacilityCount,
            @SubFacilityCount,

            @ReturnedRecordCount,
            @IncludeDaysMetCount,
            @MappedDetailCount,
            @UnmappedDetailCount,

            'Error',

            ERROR_NUMBER(),
            ERROR_LINE(),
            ERROR_MESSAGE()
        );

    END CATCH;


    SET @RangeOrder = @RangeOrder + 1;

END;


------------------------------------------------------------
-- 17) SIX-RANGE OVERALL HB SUMMARY
--
-- Combined Inpatient and Outpatient
------------------------------------------------------------

SELECT
    RangeOrder,
    RangeLabel,
    AnalysisPeriodID,
    ActivityThroughPeriodID,

    COUNT_BIG(1) AS TransactionRowCount,

    COUNT(DISTINCT AccountNumber) AS DistinctAccountCount,

    SUM
    (
        CASE
            WHEN RecoveryTakeback = 'Net Recovery'
            THEN TransactionAmount
            ELSE 0
        END
    ) AS NetRecoveryAmount,

    SUM
    (
        CASE
            WHEN RecoveryTakeback = 'Net Takeback'
            THEN TransactionAmount
            ELSE 0
        END
    ) AS NetTakebackAmount,

    SUM(TransactionAmount) AS NetAmount

FROM #AR059HBDetail

GROUP BY
    RangeOrder,
    RangeLabel,
    AnalysisPeriodID,
    ActivityThroughPeriodID

ORDER BY
    RangeOrder;


