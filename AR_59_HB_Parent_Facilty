USE [RCA_Code];
GO

SET NOCOUNT ON;
SET XACT_ABORT ON;


/*==============================================================

 HB AR059 RECOVERY DETAIL

 HB hierarchy:

 Corporate
     Region
         Parent Facility / Source Facility
             SubFacility

 This version:

 1. Loads all HB SubFacilities from RCA_Data.Analysis.dimFacility.
 2. Retains Region, Parent Facility, and SubFacility.
 3. Passes SubFacility IDs to the HB AR059 procedure.
 4. Includes both Inpatient and Outpatient.
 5. Runs the AR059 procedure for six ranges.
 6. Returns summaries and complete transaction detail.
 7. Uses Parent Facility as the primary requested grouping.

==============================================================*/


------------------------------------------------------------
-- 1) GENERAL SETTINGS
------------------------------------------------------------

DECLARE @Username VARCHAR(50) = 'BHCS\vstevens';

DECLARE @InOutTypes VARCHAR(50) = 'Inpatient,Outpatient';

DECLARE @RAC INT = 1;

DECLARE @ExcludeAccounts INT = 0;

DECLARE @Status VARCHAR(20) = 'BAD DEBT,INACTIVE';

DECLARE @PayorType VARCHAR(31) = 'Financial Class';

/*
NULL means all financial classes/payors.
*/
DECLARE @PayorCodes VARCHAR(MAX) = NULL;

DECLARE @SystemType VARCHAR(MAX) = NULL;

DECLARE @UDFilter1 VARCHAR(MAX) = NULL;

DECLARE @DaysThreshold INT = 30;

DECLARE @AuthMode VARCHAR(10) = 'AD';


------------------------------------------------------------
-- 2) SIX RECOVERY RANGES
--
-- AnalysisPeriodID:
-- Analysis Date selected in Crowe
--
-- ActivityThroughPeriodID:
-- Activity Through date selected in Crowe
------------------------------------------------------------

DECLARE @Ranges TABLE
(
    RangeOrder INT NOT NULL PRIMARY KEY,
    RangeLabel VARCHAR(100) NOT NULL,
    AnalysisPeriodID INT NOT NULL,
    ActivityThroughPeriodID INT NOT NULL
);

INSERT INTO @Ranges
(
    RangeOrder,
    RangeLabel,
    AnalysisPeriodID,
    ActivityThroughPeriodID
)
VALUES
    (1, 'Range 1', 20250731, 20260731),
    (2, 'Range 2', 20250630, 20260630),
    (3, 'Range 3', 20250531, 20260531),
    (4, 'Range 4', 20250430, 20260430),
    (5, 'Range 5', 20250331, 20260331),
    (6, 'Range 6', 20250831, 20260831);


------------------------------------------------------------
-- 3) VALIDATE RANGE DATES
------------------------------------------------------------

IF EXISTS
(
    SELECT 1
    FROM @Ranges
    WHERE AnalysisPeriodID >= ActivityThroughPeriodID
)
BEGIN
    THROW 50001,
        'Each Analysis Period must be earlier than its Activity Through Period.',
        1;
END;


------------------------------------------------------------
-- 4) CREATE HB FACILITY HIERARCHY
--
-- df:
-- Lowest-level SubFacility passed into AR059
--
-- sourceFac:
-- Parent Facility shown in the HB facility selector
--
-- region:
-- Region such as Central or Northern
------------------------------------------------------------

IF OBJECT_ID('tempdb..#HBFacilityHierarchy') IS NOT NULL
    DROP TABLE #HBFacilityHierarchy;

CREATE TABLE #HBFacilityHierarchy
(
    RegionID INT NULL,
    RegionCode VARCHAR(100) NULL,
    Region VARCHAR(255) NULL,
    RegionLevelType VARCHAR(100) NULL,

    ParentFacilityID INT NULL,
    ParentFacilityCode VARCHAR(100) NULL,
    ParentFacility VARCHAR(255) NULL,
    ParentFacilityLevelType VARCHAR(100) NULL,

    SubFacilityID INT NOT NULL,
    SubFacilityCode VARCHAR(100) NULL,
    SubFacility VARCHAR(255) NULL,
    SubFacilityLevelType VARCHAR(100) NULL
);

INSERT INTO #HBFacilityHierarchy
(
    RegionID,
    RegionCode,
    Region,
    RegionLevelType,

    ParentFacilityID,
    ParentFacilityCode,
    ParentFacility,
    ParentFacilityLevelType,

    SubFacilityID,
    SubFacilityCode,
    SubFacility,
    SubFacilityLevelType
)
SELECT DISTINCT
    region.FacilityID AS RegionID,
    region.FacilityCode AS RegionCode,
    LTRIM(RTRIM(region.FacilityName)) AS Region,
    region.FacilityLevelType AS RegionLevelType,

    sourceFac.FacilityID AS ParentFacilityID,
    sourceFac.FacilityCode AS ParentFacilityCode,
    LTRIM(RTRIM(sourceFac.FacilityName)) AS ParentFacility,
    sourceFac.FacilityLevelType AS ParentFacilityLevelType,

    df.FacilityID AS SubFacilityID,
    df.FacilityCode AS SubFacilityCode,
    LTRIM(RTRIM(df.FacilityName)) AS SubFacility,
    df.FacilityLevelType AS SubFacilityLevelType

FROM RCA_Data.Analysis.dimFacility AS df

INNER JOIN RCA_Data.Analysis.dimFacility AS sourceFac
    ON df.ParentFacilityID = sourceFac.FacilityID

INNER JOIN RCA_Data.Analysis.dimFacility AS region
    ON sourceFac.ParentFacilityID = region.FacilityID

WHERE df.FacilityLevelType = 'Subfacility'
  AND df.FacilityID IS NOT NULL;


------------------------------------------------------------
-- 5) VERIFY HB FACILITY HIERARCHY
------------------------------------------------------------

IF NOT EXISTS
(
    SELECT 1
    FROM #HBFacilityHierarchy
)
BEGIN
    THROW 50002,
        'No HB SubFacilities were found in RCA_Data.Analysis.dimFacility.',
        1;
END;


------------------------------------------------------------
-- 6) CREATE ONE MAPPING ROW PER SUBFACILITY
--
-- This prevents transaction duplication if dimFacility
-- contains more than one hierarchy row for a SubFacility.
------------------------------------------------------------

IF OBJECT_ID('tempdb..#HBFacilityMapping') IS NOT NULL
    DROP TABLE #HBFacilityMapping;

CREATE TABLE #HBFacilityMapping
(
    RegionID INT NULL,
    RegionCode VARCHAR(100) NULL,
    Region VARCHAR(255) NULL,

    ParentFacilityID INT NULL,
    ParentFacilityCode VARCHAR(100) NULL,
    ParentFacility VARCHAR(255) NULL,

    SubFacilityID INT NOT NULL,
    SubFacilityCode VARCHAR(100) NULL,
    SubFacility VARCHAR(255) NULL
);

;WITH RankedFacilityMapping AS
(
    SELECT
        H.RegionID,
        H.RegionCode,
        H.Region,

        H.ParentFacilityID,
        H.ParentFacilityCode,
        H.ParentFacility,

        H.SubFacilityID,
        H.SubFacilityCode,
        H.SubFacility,

        ROW_NUMBER() OVER
        (
            PARTITION BY H.SubFacilityID
            ORDER BY
                CASE
                    WHEN H.Region IS NULL THEN 1
                    ELSE 0
                END,
                H.Region,
                CASE
                    WHEN H.ParentFacility IS NULL THEN 1
                    ELSE 0
                END,
                H.ParentFacility,
                H.SubFacility
        ) AS MappingRow

    FROM #HBFacilityHierarchy AS H
)
INSERT INTO #HBFacilityMapping
(
    RegionID,
    RegionCode,
    Region,

    ParentFacilityID,
    ParentFacilityCode,
    ParentFacility,

    SubFacilityID,
    SubFacilityCode,
    SubFacility
)
SELECT
    RegionID,
    RegionCode,
    Region,

    ParentFacilityID,
    ParentFacilityCode,
    ParentFacility,

    SubFacilityID,
    SubFacilityCode,
    SubFacility
FROM RankedFacilityMapping
WHERE MappingRow = 1;


------------------------------------------------------------
-- 7) BUILD COMMA-SEPARATED SUBFACILITY LIST
------------------------------------------------------------

DECLARE @FacilityIDs VARCHAR(MAX);

DECLARE @SubFacilityCount INT;

DECLARE @ParentFacilityCount INT;

DECLARE @RegionCount INT;

SELECT
    @FacilityIDs =
        STUFF
        (
            (
                SELECT
                    ',' + CAST(F.SubFacilityID AS VARCHAR(20))
                FROM
                (
                    SELECT DISTINCT
                        SubFacilityID
                    FROM #HBFacilityMapping
                ) AS F
                ORDER BY
                    F.SubFacilityID
                FOR XML PATH(''), TYPE
            ).value('.', 'VARCHAR(MAX)'),
            1,
            1,
            ''
        );

SELECT
    @SubFacilityCount =
        COUNT(DISTINCT SubFacilityID),

    @ParentFacilityCount =
        COUNT
        (
            DISTINCT CASE
                WHEN ParentFacilityID IS NOT NULL
                THEN ParentFacilityID
            END
        ),

    @RegionCount =
        COUNT
        (
            DISTINCT CASE
                WHEN RegionID IS NOT NULL
                THEN RegionID
            END
        )
FROM #HBFacilityMapping;

IF NULLIF(LTRIM(RTRIM(@FacilityIDs)), '') IS NULL
BEGIN
    THROW 50003,
        'The HB SubFacilityID list is empty.',
        1;
END;


------------------------------------------------------------
-- 8) FACILITY HIERARCHY VALIDATION
--
-- Check this result before relying on the recovery summaries.
------------------------------------------------------------

SELECT
    RegionID,
    RegionCode,
    Region,

    ParentFacilityID,
    ParentFacilityCode,
    ParentFacility,

    SubFacilityID,
    SubFacilityCode,
    SubFacility

FROM #HBFacilityMapping

ORDER BY
    Region,
    ParentFacility,
    SubFacility,
    SubFacilityID;


------------------------------------------------------------
-- 9) FACILITY COUNTS BY REGION AND PARENT FACILITY
------------------------------------------------------------

SELECT
    RegionID,
    Region,

    ParentFacilityID,
    ParentFacility,

    COUNT(DISTINCT SubFacilityID) AS SubFacilityCount

FROM #HBFacilityMapping

GROUP BY
    RegionID,
    Region,
    ParentFacilityID,
    ParentFacility

ORDER BY
    Region,
    ParentFacility;


------------------------------------------------------------
-- 10) OVERALL FACILITY SELECTION INFORMATION
------------------------------------------------------------

SELECT
    'All HB' AS ProcessingScope,
    @RegionCount AS RegionCount,
    @ParentFacilityCount AS ParentFacilityCount,
    @SubFacilityCount AS SubFacilityCount,
    @FacilityIDs AS SubFacilityIDList;


