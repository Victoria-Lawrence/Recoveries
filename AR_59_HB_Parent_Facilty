------------------------------------------------------------

IF OBJECT_ID('tempdb..#AR059Stage') IS NOT NULL
    DROP TABLE #AR059Stage;

CREATE TABLE #AR059Stage
(
    FacilityID INT,
    FacilityName VARCHAR(256),
