------------------------------------------------------------
-- 22) SUBFACILITY SUMMARY
--
-- Retained for reconciliation to the underlying facility IDs.
------------------------------------------------------------

SELECT
    RangeOrder,
    RangeLabel,
    AnalysisPeriodID,
    ActivityThroughPeriodID,

    RegionID,
    Region,

    ParentFacilityID,
    ParentFacility,

    MappedSubFacilityID AS SubFacilityID,
    MappedSubFacilityCode AS SubFacilityCode,
    MappedSubFacility AS SubFacility,

    InOutType,

    COUNT_BIG(1) AS TransactionRowCount,

    COUNT(DISTINCT AccountNumber) AS DistinctAccountCount,

    SUM
    (
        CASE
            WHEN RecoveryTakeback = 'Net Recovery'
            THEN TransactionAmount
            ELSE 0
        END
    ) AS NetRecoveryAmount,

    SUM
    (
        CASE
            WHEN RecoveryTakeback = 'Net Takeback'
            THEN TransactionAmount
            ELSE 0
        END
    ) AS NetTakebackAmount,

    SUM(TransactionAmount) AS NetAmount

FROM #AR059HBDetail

GROUP BY
    RangeOrder,
    RangeLabel,
    AnalysisPeriodID,
    ActivityThroughPeriodID,

    RegionID,
    Region,

    ParentFacilityID,
    ParentFacility,

    MappedSubFacilityID,
    MappedSubFacilityCode,
    MappedSubFacility,

    InOutType

ORDER BY
    RangeOrder,
    Region,
    ParentFacility,
    MappedSubFacility,
    InOutType;


------------------------------------------------------------
-- 23) PARENT FACILITY FINANCIAL CLASS SUMMARY
------------------------------------------------------------

SELECT
    RangeOrder,
    RangeLabel,
    AnalysisPeriodID,
    ActivityThroughPeriodID,

    Region,
    ParentFacility,
    InOutType,

    FCCode AS FinancialClassCode,
    FCName AS FinancialClass,

    RecoveryTakeback,

    COUNT_BIG(1) AS TransactionRowCount,

    COUNT(DISTINCT AccountNumber) AS DistinctAccountCount,

    SUM(TransactionAmount) AS TotalTransactionAmount

FROM #AR059HBDetail

GROUP BY
    RangeOrder,
    RangeLabel,
    AnalysisPeriodID,
    ActivityThroughPeriodID,

    Region,
    ParentFacility,
    InOutType,

    FCCode,
    FCName,

    RecoveryTakeback

ORDER BY
    RangeOrder,
    Region,
    ParentFacility,
    InOutType,
    FCName,
    RecoveryTakeback;


------------------------------------------------------------
-- 24) UNMAPPED FACILITY DIAGNOSTICS
--
-- Ideally, this returns no rows.
--
-- If rows appear here, AR059 returned a FacilityID that did
-- not match a SubFacilityID in the hierarchy.
------------------------------------------------------------

SELECT
    RangeOrder,
    RangeLabel,
    AnalysisPeriodID,
    ActivityThroughPeriodID,

    FacilityID,
    FacilityName,

    ReturnedRecordCount

FROM #AR059UnmappedFacilities

ORDER BY
    RangeOrder,
    FacilityName,
    FacilityID;


------------------------------------------------------------
-- 25) RUN LOG
--
-- All six ranges should show Completed.
--
-- IncludeDaysMetCount should equal:
--
-- MappedDetailCount + UnmappedDetailCount
------------------------------------------------------------

SELECT
    RangeOrder,
    RangeLabel,
    AnalysisPeriodID,
    ActivityThroughPeriodID,

    RegionCount,
    ParentFacilityCount,
    SubFacilityCount,

    ReturnedRecordCount,
    IncludeDaysMetCount,
    MappedDetailCount,
    UnmappedDetailCount,

    IncludeDaysMetCount
        - MappedDetailCount
        - UnmappedDetailCount AS ReconciliationDifference,

    RunStatus,

    ErrorNumber,
    ErrorLine,
    ErrorMessage

FROM #AR059RunLog

ORDER BY
    RangeOrder;


------------------------------------------------------------
-- 26) COMPLETE HB TRANSACTION DETAIL
--
-- This is the complete result to export.
--
-- Parent Facility is included for the requested grouping.
-- SubFacility is retained for reconciliation.
------------------------------------------------------------

SELECT
    RangeOrder,
    RangeLabel,
    AnalysisPeriodID,
    ActivityThroughPeriodID,

    RegionID,
    RegionCode,
    Region,

    ParentFacilityID,
    ParentFacilityCode,
    ParentFacility,

    MappedSubFacilityID AS SubFacilityID,
    MappedSubFacilityCode AS SubFacilityCode,
    MappedSubFacility AS SubFacility,

    FacilityID AS AR059FacilityID,
    FacilityName AS AR059FacilityName,

    InOutType,
    AccountNumber,

    RecoveryTakeback,
    PostingDate,

    TransactionCode,
    TransactionDescription,
    TransactionAmount,

    SIPGCode,
    SIPGName,

    FCCode,
    FCName,

    IPCode,
    IPName,

    BillingType,
    AdmissionDate,
    DischargeDate,

    [Status],
    DaysFromAdmission,
    IncludeExclude,
    PriorTransaction

FROM #AR059HBDetail

ORDER BY
    RangeOrder,
    Region,
    ParentFacility,
    MappedSubFacility,
    InOutType,
    AccountNumber,
    PostingDate,
    TransactionCode;
