USE [RCA_Code];
GO

SET NOCOUNT ON;
SET XACT_ABORT ON;

/*==============================================================
 HB AR059 RECOVERY SUMMARY

 HB hierarchy:
     Region
         Parent Facility
             SubFacility

 Final output level:
     Range
     Parent Facility
     Inpatient / Outpatient
     Financial Class
     Recovery / Takeback

 No separate PostingDate filter is applied.
==============================================================*/

------------------------------------------------------------
-- 1) GENERAL SETTINGS
------------------------------------------------------------

DECLARE @Username VARCHAR(50) = 'BHCS\vstevens';
DECLARE @InOutTypes VARCHAR(50) = 'Inpatient,Outpatient';
DECLARE @RAC INT = 1;
DECLARE @ExcludeAccounts INT = 0;
DECLARE @Status VARCHAR(20) = 'BAD DEBT,INACTIVE';
DECLARE @PayorType VARCHAR(31) = 'Financial Class';
DECLARE @PayorCodes VARCHAR(MAX) = NULL;
DECLARE @SystemType VARCHAR(MAX) = NULL;
DECLARE @UDFilter1 VARCHAR(MAX) = NULL;
DECLARE @DaysThreshold INT = 30;
DECLARE @AuthMode VARCHAR(10) = 'AD';

------------------------------------------------------------
-- 2) SIX RECOVERY RANGES
------------------------------------------------------------

DECLARE @Ranges TABLE
(
    RangeOrder INT NOT NULL PRIMARY KEY,
    RangeLabel VARCHAR(100) NOT NULL,
    AnalysisPeriodID INT NOT NULL,
    ActivityThroughPeriodID INT NOT NULL
);

