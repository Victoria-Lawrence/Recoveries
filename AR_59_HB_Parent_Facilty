------------------------------------------------------------
-- 13) CREATE UNMAPPED FACILITY DIAGNOSTIC TABLE
------------------------------------------------------------

IF OBJECT_ID('tempdb..#AR059HBUnmappedFacilities') IS NOT NULL
    DROP TABLE #AR059HBUnmappedFacilities;

CREATE TABLE #AR059HBUnmappedFacilities
(
    RangeOrder INT,
    RangeLabel VARCHAR(100),
    AnalysisPeriodID INT,
    ActivityThroughPeriodID INT,
    FacilityID INT,
    FacilityName VARCHAR(256),
    IncludedRecordCount BIGINT
);

------------------------------------------------------------
-- 14) CREATE RUN LOG
------------------------------------------------------------

IF OBJECT_ID('tempdb..#AR059HBRunLog') IS NOT NULL
    DROP TABLE #AR059HBRunLog;

CREATE TABLE #AR059HBRunLog
(
    RangeOrder INT,
    RangeLabel VARCHAR(100),
    AnalysisPeriodID INT,
    ActivityThroughPeriodID INT,
    RegionCount INT,
    ParentFacilityCount INT,
    SubFacilityCount INT,
    ReturnedRecordCount BIGINT,
    IncludeDaysMetCount BIGINT,
    MappedRecordCount BIGINT,
    UnmappedRecordCount BIGINT,
    RunStatus VARCHAR(20),
    ErrorNumber INT NULL,
    ErrorLine INT NULL,
    ErrorMessage VARCHAR(4000) NULL
);

------------------------------------------------------------
-- 15) DECLARE LOOP VARIABLES
------------------------------------------------------------

DECLARE @RangeOrder INT;
DECLARE @MaximumRangeOrder INT;
DECLARE @RangeLabel VARCHAR(100);
DECLARE @PeriodID INT;
DECLARE @EndPeriodID INT;
DECLARE @ReturnedRecordCount BIGINT;
DECLARE @IncludeDaysMetCount BIGINT;
DECLARE @MappedRecordCount BIGINT;
DECLARE @UnmappedRecordCount BIGINT;

SELECT
    @RangeOrder = MIN(RangeOrder),
    @MaximumRangeOrder = MAX(RangeOrder)
FROM @Ranges;

------------------------------------------------------------
-- 16) RUN HB AR059 FOR EACH RANGE
------------------------------------------------------------

WHILE @RangeOrder <= @MaximumRangeOrder
BEGIN
    SELECT
        @RangeLabel = RangeLabel,
        @PeriodID = AnalysisPeriodID,
        @EndPeriodID = ActivityThroughPeriodID
    FROM @Ranges
    WHERE RangeOrder = @RangeOrder;

    TRUNCATE TABLE #AR059Stage;

    SET @ReturnedRecordCount = 0;
    SET @IncludeDaysMetCount = 0;
    SET @MappedRecordCount = 0;
    SET @UnmappedRecordCount = 0;

    BEGIN TRY
        ----------------------------------------------------
        -- RUN HB AR059
        ----------------------------------------------------

        INSERT INTO #AR059Stage
        (
            FacilityID,
            FacilityName,
            InOutType,
            AccountNumber,
            SIPGCode,
            SIPGName,
            FCCode,
            FCName,
            IPCode,
            IPName,
            PostingDate,
            BillingType,
            AdmissionDate,
            DischargeDate,
            TransactionCode,
            TransactionDescription,
            TransactionAmount,
            [Status],
            RecoveryTakeback,
            DaysFromAdmission,
            IncludeExclude,
            PriorTransaction
        )
        EXEC RCA_Code.Analysis.pr_AR059_BadDebtAndInactiveAccountRecoveryPayments
            @FacilityIDs = @FacilityIDs,
            @PeriodID = @PeriodID,
            @EndPeriodID = @EndPeriodID,
            @InOutTypes = @InOutTypes,
            @Username = @Username,
            @RAC = @RAC,
            @ExcludeAccounts = @ExcludeAccounts,
            @Status = @Status,
            @PayorType = @PayorType,
            @PayorCodes = @PayorCodes,
            @SystemType = @SystemType,
            @UDFilter1 = @UDFilter1,
            @DaysThreshold = @DaysThreshold,
            @AuthMode = @AuthMode;

        ----------------------------------------------------
        -- COUNT RETURNED AND INCLUDED RECORDS
        ----------------------------------------------------

        SELECT
            @ReturnedRecordCount = COUNT_BIG(1)
        FROM #AR059Stage;

        SELECT
            @IncludeDaysMetCount = COUNT_BIG(1)
        FROM #AR059Stage
        WHERE IncludeExclude = 'Include Days Met';

        ----------------------------------------------------
        -- COUNT MAPPED RECORDS
        ----------------------------------------------------

        SELECT
            @MappedRecordCount = COUNT_BIG(1)
        FROM #AR059Stage AS AR
        INNER JOIN #HBFacilityMapping AS HM
            ON HM.SubFacilityID = AR.FacilityID
        WHERE AR.IncludeExclude = 'Include Days Met';

        ----------------------------------------------------
        -- COUNT UNMAPPED RECORDS
        ----------------------------------------------------

        SELECT
            @UnmappedRecordCount = COUNT_BIG(1)
        FROM #AR059Stage AS AR
        LEFT JOIN #HBFacilityMapping AS HM
            ON HM.SubFacilityID = AR.FacilityID
        WHERE AR.IncludeExclude = 'Include Days Met'
          AND HM.SubFacilityID IS NULL;

        ----------------------------------------------------
        -- SAVE UNMAPPED FACILITIES
        ----------------------------------------------------

        INSERT INTO #AR059HBUnmappedFacilities
        (
            RangeOrder,
            RangeLabel,
            AnalysisPeriodID,
            ActivityThroughPeriodID,
            FacilityID,
            FacilityName,
            IncludedRecordCount
        )
        SELECT
            @RangeOrder,
            @RangeLabel,
            @PeriodID,
            @EndPeriodID,
            AR.FacilityID,
            AR.FacilityName,
            COUNT_BIG(1)
        FROM #AR059Stage AS AR
        LEFT JOIN #HBFacilityMapping AS HM
            ON HM.SubFacilityID = AR.FacilityID
        WHERE AR.IncludeExclude = 'Include Days Met'
          AND HM.SubFacilityID IS NULL
        GROUP BY
            AR.FacilityID,
            AR.FacilityName;

        ----------------------------------------------------
        -- SAVE REQUESTED HB SUMMARY
        ----------------------------------------------------

        INSERT INTO #AR059HBSummary
        (
            RangeOrder,
            RangeLabel,
            AnalysisPeriodID,
            ActivityThroughPeriodID,
            ParentFacilityID,
            ParentFacility,
            InOutType,
            FinancialClassCode,
            FinancialClass,
            RecoveryTakeback,
            TransactionRowCount,
            DistinctAccountCount,
            TotalTransactionAmount
        )
        SELECT
            @RangeOrder,
            @RangeLabel,
            @PeriodID,
            @EndPeriodID,
            HM.ParentFacilityID,
            HM.ParentFacility,
            AR.InOutType,
            AR.FCCode,
            AR.FCName,
            AR.RecoveryTakeback,
            COUNT_BIG(1),
            COUNT(DISTINCT AR.AccountNumber),
            SUM(AR.TransactionAmount)
        FROM #AR059Stage AS AR
        INNER JOIN #HBFacilityMapping AS HM
            ON HM.SubFacilityID = AR.FacilityID
        WHERE AR.IncludeExclude = 'Include Days Met'
        GROUP BY
            HM.ParentFacilityID,
            HM.ParentFacility,
            AR.InOutType,
            AR.FCCode,
            AR.FCName,
            AR.RecoveryTakeback;

        ----------------------------------------------------
        -- LOG COMPLETED RANGE
        ----------------------------------------------------

        INSERT INTO #AR059HBRunLog
        (
            RangeOrder,
            RangeLabel,
            AnalysisPeriodID,
            ActivityThroughPeriodID,
            RegionCount,
            ParentFacilityCount,
            SubFacilityCount,
            ReturnedRecordCount,
            IncludeDaysMetCount,
            MappedRecordCount,
            UnmappedRecordCount,
            RunStatus,
            ErrorNumber,
            ErrorLine,
            ErrorMessage
        )
        VALUES
        (
            @RangeOrder,
            @RangeLabel,
            @PeriodID,
            @EndPeriodID,
            @RegionCount,
            @ParentFacilityCount,
            @SubFacilityCount,
            @ReturnedRecordCount,
            @IncludeDaysMetCount,
            @MappedRecordCount,
            @UnmappedRecordCount,
            'Completed',
            NULL,
            NULL,
            NULL
        );
    END TRY

    BEGIN CATCH
        ----------------------------------------------------
        -- LOG ERROR AND CONTINUE TO NEXT RANGE
        ----------------------------------------------------

        INSERT INTO #AR059HBRunLog
        (
            RangeOrder,
            RangeLabel,
            AnalysisPeriodID,
            ActivityThroughPeriodID,
            RegionCount,
            ParentFacilityCount,
            SubFacilityCount,
            ReturnedRecordCount,
            IncludeDaysMetCount,
            MappedRecordCount,
            UnmappedRecordCount,
            RunStatus,
            ErrorNumber,
            ErrorLine,
            ErrorMessage
        )
        VALUES
        (
            @RangeOrder,
            @RangeLabel,
            @PeriodID,
            @EndPeriodID,
            @RegionCount,
            @ParentFacilityCount,
            @SubFacilityCount,
            @ReturnedRecordCount,
            @IncludeDaysMetCount,
            @MappedRecordCount,
            @UnmappedRecordCount,
            'Error',
            ERROR_NUMBER(),
            ERROR_LINE(),
            ERROR_MESSAGE()
        );
    END CATCH;

    SET @RangeOrder = @RangeOrder + 1;
END;

------------------------------------------------------------
-- 17) FINAL HB SUMMARY
--
-- Requested deliverable
------------------------------------------------------------

SELECT
    RangeOrder,
    RangeLabel,
    AnalysisPeriodID,
    ActivityThroughPeriodID,
    ParentFacility AS [Parent Facility],
    InOutType,
    FinancialClassCode,
    FinancialClass,
    RecoveryTakeback,
    TransactionRowCount,
    DistinctAccountCount,
    TotalTransactionAmount
FROM #AR059HBSummary
ORDER BY
    RangeOrder,
    ParentFacility,
    InOutType,
    FinancialClass,
    RecoveryTakeback;

------------------------------------------------------------
-- 18) UNMAPPED FACILITY DIAGNOSTICS
--
-- Ideally returns no rows
------------------------------------------------------------

SELECT
    RangeOrder,
    RangeLabel,
    AnalysisPeriodID,
    ActivityThroughPeriodID,
    FacilityID,
    FacilityName,
    IncludedRecordCount
FROM #AR059HBUnmappedFacilities
ORDER BY
    RangeOrder,
    FacilityName,
    FacilityID;

------------------------------------------------------------
-- 19) RUN LOG
--
-- All six ranges should show Completed.
-- ReconciliationDifference should equal 0.
------------------------------------------------------------

SELECT
    RangeOrder,
    RangeLabel,
    AnalysisPeriodID,
    ActivityThroughPeriodID,
    RegionCount,
    ParentFacilityCount,
    SubFacilityCount,
    ReturnedRecordCount,
    IncludeDaysMetCount,
    MappedRecordCount,
    UnmappedRecordCount,
    IncludeDaysMetCount
        - MappedRecordCount
        - UnmappedRecordCount AS ReconciliationDifference,
    RunStatus,
    ErrorNumber,
    ErrorLine,
    ErrorMessage
FROM #AR059HBRunLog
ORDER BY
    RangeOrder;
