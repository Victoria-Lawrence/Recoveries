    SIPGCode VARCHAR(50),
    SIPGName VARCHAR(256),
    FCCode VARCHAR(50),
    FCName VARCHAR(256),
    IPCode VARCHAR(50),
    IPName VARCHAR(256),
    PostingDate DATETIME,
    BillingType VARCHAR(50),
    AdmissionDate DATETIME,
    DischargeDate DATETIME,
    TransactionCode VARCHAR(50),
    TransactionDescription VARCHAR(256),
    TransactionAmount MONEY,
    [Status] VARCHAR(20),
    RecoveryTakeback VARCHAR(20),
    DaysFromAdmission INT,
    IncludeExclude VARCHAR(50),
    PriorTransaction VARCHAR(50)
);

------------------------------------------------------------
-- 12) CREATE FINAL HB SUMMARY TABLE
------------------------------------------------------------

IF OBJECT_ID('tempdb..#AR059HBSummary') IS NOT NULL
    DROP TABLE #AR059HBSummary;

CREATE TABLE #AR059HBSummary
(
    RangeOrder INT NOT NULL,
    RangeLabel VARCHAR(100) NOT NULL,
    AnalysisPeriodID INT NOT NULL,
    ActivityThroughPeriodID INT NOT NULL,
    ParentFacilityID INT NULL,
    ParentFacility VARCHAR(255) NULL,
    InOutType VARCHAR(32) NULL,
    FinancialClassCode VARCHAR(50) NULL,
    FinancialClass VARCHAR(256) NULL,
    RecoveryTakeback VARCHAR(20) NULL,
    TransactionRowCount BIGINT NOT NULL,
    DistinctAccountCount BIGINT NOT NULL,
    TotalTransactionAmount MONEY NULL
